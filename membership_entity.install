<?php

/**
 * @file
 * Install, update, and uninstall functions for the membership_entity module.
 */

/**
 * Implements hook_requirements().
 */
function membership_entity_requirements($phase) {
  $requirements = array();
  $t = get_t();

  if ($phase == 'runtime' && !module_exists('membership_entity_type')) {
    $data = membership_entity_get_bundle_settings();
    if (empty($data['status'])) {
      $requirements['membership_entity_settings'] = array(
        'title' => $t('Membership Settings'),
        'value' => $t('Missing configuration'),
        'description' => $t('The membership entity module is missing configuration settings. Please visit the <a href="!url">settings page</a> to configure the module.', array(
          '!url' => url('admin/memberships/types/manage/membership'),
        )),
        'severity' => REQUIREMENT_ERROR,
      );
    }
  }

  return $requirements;
}

/**
 * Implements hook_schema().
 */
function membership_entity_schema() {
  $schema['membership_entity'] = array(
    'description' => 'The base table for memberships.',
    'fields' => array(
      'mid' => array(
        'description' => 'The primary identifier for a membership.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'member_id' => array(
        'description' => 'A user enterable unique member id.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ),
      'type' => array(
        'description' => 'The type (bundle) of this membership.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ),
      'uid' => array(
        'description' => 'The user id of the primary member.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'pid' => array(
        'description' => 'The mid of the parent membership, or 0 for a top level membership.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'status' => array(
        'description' => 'Integer code indicating the membership status.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
      ),
      'no_contact' => array(
        'description' => 'Whether the member should never be contacted, for instance because they have died.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ),
      'member_name' => array(
        'description' => 'The primary member\'s name, kept only where the user account has been deleted and the membership retained.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'default' => NULL,
      ),
      'created' => array(
        'description' => 'The Unix timestamp when the membership was created.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'changed' => array(
        'description' => 'The Unix timestamp when the membership was most recently saved.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'indexes' => array(
      'membership_entity_uid' => array('uid'),
      'membership_entity_pid' => array('pid'),
      'membership_entity_changed' => array('changed'),
      'membership_entity_created' => array('created'),
      'membership_entity_status_type' => array('status', 'type', 'mid'),
      'membership_entity_member_id_type' => array('member_id', array('type', 4)),
      'membership_entity_type' => array(array('type', 4)),
    ),
    'unique keys' => array(
      'member_id' => array('member_id'),
    ),
    'primary key' => array('mid'),
    'foreign keys' => array(
      'membership_entity_primary_member' => array(
        'table' => 'users',
        'columns' => array('uid' => 'uid'),
      ),
    ),
  );

  $schema['membership_entity_secondary_member'] = array(
    'description' => 'Secondary members.',
    'fields' => array(
      'mid' => array(
        'description' => 'The membership identifier.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'uid' => array(
        'description' => 'The user id of the secondary member.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'weight' => array(
        'description' => 'The display order for listing secondary members.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
      ),
    ),
    'primary key' => array('mid', 'uid'),
    'foreign keys' => array(
      'membership_entity_membership' => array(
        'table' => 'membership_entity',
        'columns' => array('mid' => 'mid'),
      ),
      'membership_entity_secondary_member' => array(
        'table' => 'users',
        'columns' => array('uid' => 'uid'),
      ),
    ),
  );

  return $schema;
}

/**
 * Add the parent membership column to support hierarchical memberships.
 */
function membership_entity_update_1000() {
  if (!db_field_exists('membership_entity', 'pid')) {
    db_add_field('membership_entity', 'pid', array(
      'description' => 'The mid of the parent membership, or 0 for a top level membership.',
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    ), array(
      'indexes' => array(
        'membership_entity_pid' => array('pid'),
      ),
    ));
  }
}

/**
 * Remember who a membership belonged to, for records that outlive the account.
 */
function membership_entity_update_1001() {
  if (!db_field_exists('membership_entity', 'member_name')) {
    db_add_field('membership_entity', 'member_name', array(
      'description' => 'The primary member\'s name, kept only where the user account has been deleted and the membership retained.',
      'type' => 'varchar',
      'length' => 255,
      'not null' => FALSE,
      'default' => NULL,
    ));
  }
}

/**
 * Add the do not contact flag.
 */
function membership_entity_update_1002() {
  if (!db_field_exists('membership_entity', 'no_contact')) {
    db_add_field('membership_entity', 'no_contact', array(
      'description' => 'Whether the member should never be contacted, for instance because they have died.',
      'type' => 'int',
      'size' => 'tiny',
      'not null' => TRUE,
      'default' => 0,
    ));
  }
}

/**
 * Move sub-members and postal members into their own submodules.
 *
 * Each is enabled here wherever the site is already using it, so nothing an
 * existing site does stops working: hierarchy where any membership has a parent
 * or any type allows sub-members, postal where postal members are switched on
 * or any account already holds a generated address.
 */
function membership_entity_update_1003() {
  $messages = array();
  $config = config('membership_entity.settings');

  // Sub-members. The settings live in each type's data, and the defaults for
  // them have moved with the code, so read what is stored.
  $hierarchy = (bool) db_query_range('SELECT 1 FROM {membership_entity} WHERE pid > 0', 0, 1)->fetchField();
  if (!$hierarchy) {
    foreach (array_keys(membership_entity_get_bundles()) as $bundle) {
      $settings = membership_entity_get_bundle_settings($bundle);
      if (!empty($settings['max_children'])) {
        $hierarchy = TRUE;
        break;
      }
    }
  }

  if ($hierarchy && !module_exists('membership_entity_hierarchy')) {
    if (module_exists('membership_entity_term')) {
      module_enable(array('membership_entity_hierarchy'), FALSE);
      $messages[] = t('Sub-members are in use, so Membership Entity Hierarchy has been enabled.');
    }
    else {
      $messages[] = t('Sub-members are in use, but Membership Entity Hierarchy needs Membership Entity Terms, which is not enabled. Enable both to manage them again.');
    }
  }

  // The renewals view moved from membership_entity_term with the roster code.
  // Without the module its tab would offer an action that no longer exists.
  $view = config('views.view.membership_entity_renewals');
  if (!$view->isNew()) {
    if (module_exists('membership_entity_hierarchy')) {
      $view->set('module', 'membership_entity_hierarchy')->save();
    }
    elseif ($view->get('module') == 'membership_entity_term') {
      $view->delete();
    }
  }

  // Postal members. The generator and the mail suppression used to run on
  // every site whatever the setting said, so any account already holding a
  // generated address keeps the module too.
  $domain = $config->get('postal_mail_domain');
  if (empty($domain)) {
    global $base_url;
    $host = preg_replace('/^www\./', '', (string) parse_url($base_url, PHP_URL_HOST));
    $domain = (!empty($host) ? $host : 'membership') . '.invalid';
  }
  $postal = (bool) $config->get('postal_members')
    || (bool) db_query_range('SELECT 1 FROM {users} WHERE mail LIKE :mail', 0, 1, array(
      ':mail' => '%@' . db_like($domain),
    ))->fetchField();

  if ($postal && !module_exists('membership_entity_postal')) {
    module_enable(array('membership_entity_postal'), FALSE);
    $messages[] = t('Postal members are in use, so Membership Entity Postal Members has been enabled.');
  }
  // Only while the old keys are still there: run a second time, this would
  // otherwise overwrite the moved settings with empty values.
  if (module_exists('membership_entity_postal') && $config->get('postal_members') !== NULL) {
    config('membership_entity_postal.settings')
      ->set('postal_members', (bool) $config->get('postal_members'))
      ->set('postal_mail_domain', (string) $config->get('postal_mail_domain'))
      ->save();
  }

  $config->clear('postal_members')->clear('postal_mail_domain')->save();

  return implode(' ', $messages);
}

/**
 * Restore membership roles lost to an older membership of the same person.
 *
 * Before 1.1.0 a lapsed, saved or deleted membership removed its role even
 * where the member held another active membership granting it - typically one
 * they rejoined with under a new number. Gives every active member the role
 * their membership grants. Roles are only added here, never removed.
 */
function membership_entity_update_1004() {
  module_load_include('module', 'membership_entity');
  $mids = db_query('SELECT mid FROM {membership_entity} WHERE status = :active', array(
    ':active' => MEMBERSHIP_ENTITY_ACTIVE,
  ))->fetchCol();

  $restored = 0;
  foreach (array_chunk($mids, 100) as $chunk) {
    foreach (membership_entity_load_multiple($chunk) as $membership) {
      if (membership_entity_effective_status($membership) != MEMBERSHIP_ENTITY_ACTIVE) {
        continue;
      }
      $data = membership_entity_get_bundle_settings($membership->type);
      $grants = array($membership->uid => $data['primary_role']);
      foreach ($membership->secondary_members as $uid) {
        $grants[$uid] = $data['secondary_role'];
      }
      foreach ($grants as $uid => $rid) {
        $account = $rid ? user_load($uid) : FALSE;
        if ($account && !in_array($rid, $account->roles, TRUE)) {
          $account->roles[] = $rid;
          user_save($account);
          $restored++;
        }
      }
    }
    entity_get_controller('membership_entity')->resetCache();
  }

  return format_plural($restored, 'Restored a membership role to 1 account.', 'Restored membership roles to @count accounts.');
}

/**
 * Implements hook_uninstall().
 */
function membership_entity_uninstall() {
  // Remove the module config settings.
  $config = config('membership_entity.settings');
  $config->delete();
  // Remove the default membership entity view.
  $config = config('views.view.membership_entity_memberships');
  $config->delete();
}
