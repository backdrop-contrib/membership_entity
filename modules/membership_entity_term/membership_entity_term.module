}

/**
 * Implements hook_membership_entity_term_end_date_alter().
 *
 * Where a membership type renews on a fixed date, every term ends on that date
 * whenever it began. A club whose year runs to 31 March charges the same
 * subscription whether somebody joins in April or in February, and expects them
 * all to renew together — so the length of a term is really "until the next
 * renewal", and the term length chosen on the form only decides which renewal.
 *
 * @param BackdropDateTime $end
 *   The end date calculated from the start date, term length and modifiers.
 * @param object $term
 *   The term being saved.
 */
function membership_entity_term_membership_entity_term_end_date_alter(&$end, $term) {
  // A lifetime term has no end to move, and a membership type with no fixed
  // date keeps the ordinary rolling behaviour.
  if ($term->term == 'lifetime') {
    return;
  }

  $settings = membership_entity_get_bundle_settings($term->membership_entity_type);
  if (empty($settings['fixed_renewal_date'])) {
    return;
  }

  $boundary = _membership_entity_term_renewal_boundary($settings['fixed_renewal_date']);
  if (empty($boundary)) {
    return;
  }

  // Everything below stays inside $end's own timezone. Working in timestamps
  // would silently reintroduce the server's, and midnight is exactly the moment
  // where that difference shows.
  $start = new DateTime($term->start, $end->getTimezone());

  // Snap back to the last renewal on or before the calculated end. Someone
  // joining in August on a one year term is covered to the following 31 March,
  // not to the following August.
  $snapped = _membership_entity_term_boundary_in_year($end, $boundary, (int) $end->format('Y'));
  if ($snapped > $end) {
    $snapped = _membership_entity_term_boundary_in_year($end, $boundary, (int) $end->format('Y') - 1);
  }

  // Snapping back can land on or before the start — a short term inside one
  // membership year, or a term beginning just after a renewal date. Go forward
  // to the next renewal instead, so the term always covers something.
  if ($snapped <= $start) {
    $snapped = _membership_entity_term_boundary_in_year($end, $boundary, (int) $start->format('Y'));
    if ($snapped <= $start) {
      $snapped = _membership_entity_term_boundary_in_year($end, $boundary, (int) $start->format('Y') + 1);
    }
  }

  $end->setDate((int) $snapped->format('Y'), (int) $snapped->format('n'), (int) $snapped->format('j'));
  $end->setTime(0, 0, 0);
}

/**
 * Split a stored fixed renewal date into a day and a month.
 *
 * Stored as the last day of cover, "31-3", because that is the date a member
 * recognises. The instant cover stops is the midnight after it, which is what
 * _membership_entity_term_boundary_in_year() returns.
 *
 * @param string $value
 *   The stored setting, "D-M".
 *
 * @return array|false
 *   An array of day and month, or FALSE if the setting is unusable.
 */
function _membership_entity_term_renewal_boundary($value) {
  $parts = explode('-', $value);
  if (count($parts) != 2) {
    return FALSE;
  }

  $day = (int) $parts[0];
  $month = (int) $parts[1];
  if ($day < 1 || $day > 31 || $month < 1 || $month > 12) {
    return FALSE;
  }

  return array('day' => $day, 'month' => $month);
}

/**
 * The renewal instant in a given year, in a given date's timezone.
 *
 * Cover stops at the midnight following the last day of cover, matching how
 * every other end date in this module is stored: a year ending 31 March is
 * stored as 1 April, 12:00am, which is also when the next term begins.
 *
 * @param DateTime $like
 *   A date whose timezone the result should share.
 * @param array $boundary
 *   Day and month, from _membership_entity_term_renewal_boundary().
 * @param int $year
 *   The calendar year of the last day of cover.
 *
 * @return DateTime
 *   The instant cover stops.
 */
function _membership_entity_term_boundary_in_year(DateTime $like, array $boundary, $year) {
  $date = new DateTime('now', $like->getTimezone());

  // 29 February is allowed to be chosen and simply falls back to the 28th in
  // other years, so the day is clamped to the length of the month rather than
  // being allowed to roll into the next one.
  $days_in_month = (int) date('t', mktime(0, 0, 0, $boundary['month'], 1, $year));
  $day = min($boundary['day'], $days_in_month);

  $date->setDate($year, $boundary['month'], $day);
  $date->setTime(0, 0, 0);

  // Roll to the following day, so 31 March becomes 1 April at midnight.
  $date->modify('+1 day');

  return $date;
}


/**
 * Implements hook_membership_entity_term_start_date_alter().
 */
function membership_entity_term_membership_entity_term_start_date_alter(&$start, $term) {
  // Determine the renewal start date.
  if (!empty($term->is_renewal)) {
    $membership = membership_entity_load($term->mid);
    $bundle_settings = membership_entity_get_bundle_settings($membership->type);
    $latest_term = end($membership->terms);

    if (!empty($latest_term)) {
      $grace = new BackdropDateTime($latest_term->end, 'UTC');

      // Check for grace period.
      if (preg_match(MEMBERSHIP_ENTITY_TERM_LENGTH_REGEX, $bundle_settings['grace_period'])) {
        $grace = _membership_entity_term_modify_date($grace, $bundle_settings['grace_period']);
      }

      // If the renewal is within the grace period there is no lapse in
      // membership terms. The new term starts when the old term ended.
      if ($grace > $start) {
        $start = new BackdropDateTime($latest_term->end, 'UTC');
      }
    }
  }
}

/**
 * Menu load callback for Field UI paths.
 *
 * @param string $name
 *   MembershipEntityType name.
 *
 * @return string
 *   MembershipEntityType bundle or FALSE on error.
 */
function membership_entity_term_type_load($name) {
  if ($type = membership_entity_get_bundles(strtr($name, array('-' => '_')))) {
    return $type->type;
  }
  return FALSE;
}

/**
 * Implements hook_membership_entity_type_insert().
 *
 * The bundle is the membership type's own name. It was previously created as
 * 'membership_entity_term_<type>', which is not the name a term reports: the
 * entity's bundle key is membership_entity_type, so entity_extract_ids() gives
 * back the plain type, and hook_entity_info() lists the plain type too. The
 * prefixed bundle was therefore one nothing ever referred to — harmless while
 * no term bundle had any fields on it, and a way to lose them as soon as one
 * did, because the rename below moved a bundle that did not exist and left the
 * real one pointing at a type that no longer existed.
 */
function membership_entity_term_membership_entity_type_insert($info) {
  field_attach_create_bundle('membership_entity_term', $info->type);
  membership_entity_term_add_note_field($info->type);
}

/**
 * Implements hook_membership_entity_type_update().
 */
function membership_entity_term_membership_entity_type_update($info) {
  if (!empty($info->old_type) && $info->type != $info->old_type) {
    field_attach_rename_bundle('membership_entity_term', $info->old_type, $info->type);
  }
}

/**
 * Implements hook_membership_entity_type_delete().
 */
function membership_entity_term_membership_entity_type_delete($info) {
  field_attach_delete_bundle('membership_entity_term', $info->type);
}

/**
 * Implements hook_membership_entity_term_insert().
 */
function membership_entity_term_membership_entity_term_insert($term) {
  _membership_entity_term_insert_update($term);
}

/**
 * Implements hook_membership_entity_term_update().
 */
function membership_entity_term_membership_entity_term_update($term) {
  _membership_entity_term_insert_update($term);
}

/**
 * Implements hook_membership_entity_term_delete().
 */
function membership_entity_term_membership_entity_term_delete($term) {
  _membership_entity_term_insert_update($term);
}

/**
 * Helper for membership term insert/update hooks.
 *
 * @param object $term
 *   MembershipTerm object.
 */
function _membership_entity_term_insert_update($term) {
  $membership = membership_entity_load($term->mid);

  // A parent that pays for its sub-members carries them along with it.
  _membership_entity_term_propagate_to_children($term);

  // Membership status should always match the current or latest term.
  if ($current = membership_entity_term_get_current($membership)) {
    $membership->status = $current->status;
    $membership->save();
  }
  // Reloaded rather than read from $membership->terms, which is very often
  // stale here: the membership was loaded before the term was written and the
  // entity cache hands back that same object, so the term whose save provoked
  // this hook is missing from it and the "latest" term is the one it replaced.
  // The effect is a renewal that leaves the membership on the status it was
  // renewing away from — a lapsed member marked as renewed still reading as
  // expired. Only visible where the new term has not started yet, because
  // get_current() above queries the database and so is never stale.
  elseif ($terms = membership_entity_term_load_by_membership($membership, TRUE)) {
    $membership->terms = $terms;
    $latest = end($terms);
    $membership->status = $latest->status;
    $membership->save();
  }
}

/**
 * Bring a paying parent's sub-members onto its newly renewed term.
 *
 * Where a membership type says one payment covers everyone, the sub-members
 * still hold terms of their own — that is what gives each of them a joining
 * date, a renewal history and a lapse that can be seen and annotated. They do
 * not renew themselves, so renewing the parent is what moves them on.
 *
 * This is the 'inherit' route, where sub-members are brought forward as a body.
 * Leaving somebody out of one of these renewals is done by detaching them,
 * which is already a first-class act with its own permission, rather than by
 * quietly declining to extend their term — a membership that silently stopped
 * being renewed would be indistinguishable from one nobody had got round to
 * yet. Where the parent is instead set to 'roster', it is expected that some of
 * its sub-members will not be renewed, and they are marked off one at a time
 * from the parent's renewals tab.
 *
 * @see membership_entity_term_renew_sub_member_action()
 *
 * @param object $term
 *   The term just saved against the parent membership.
 */
function _membership_entity_term_propagate_to_children($term) {
  $child_mids = membership_entity_child_mids($term->mid);
  if (empty($child_mids)) {
    return;
  }

  $parent = membership_entity_load($term->mid);
  $settings = membership_entity_get_bundle_settings($parent->type);
  if ($settings['child_terms'] != 'inherit') {
    // 'own': each sub-member pays for and renews their own membership, so the
    // parent's term is none of their business.
    //
    // 'roster': the parent pays, but only for the people on the list it sends
    // across at renewal. Carrying everybody forward here would cover the ones
    // who quietly dropped out as well, and would do it invisibly — the renewal
    // has succeeded and nobody has any reason to go looking. Those sub-members
    // are renewed one at a time instead, from the parent's renewals tab.
    return;
  }

  // Only a term that grants cover is copied down. An expiring one is not: a
  // sub-member losing access when the membership above them lapses is the
  // cascade's job, computed from the parent's status, and writing it into their
  // own term would destroy the record of what they held in their own right.
  if ((int) $term->status !== MEMBERSHIP_ENTITY_ACTIVE) {
    return;
  }

  $skipped = array();

  foreach (membership_entity_load_multiple($child_mids) as $child) {
    // Somebody the organisation has decided is no longer with them — resigned,
    // died, been removed — is not carried forward. Cancelled is the status that
    // already means "ended deliberately", so it is the one that excludes.
    //
    // Expired deliberately does NOT exclude. When a membership is renewed after
    // its date has passed, every sub-member beneath it has expired along with
    // it, and skipping them would mean a late renewal quietly renewed nobody.
    // Letting somebody go is a decision that has to be recorded as one.
    if (in_array((int) $child->status, array(MEMBERSHIP_ENTITY_CANCELLED, MEMBERSHIP_ENTITY_PENDING))) {
      $skipped[$child->mid] = $child;
      continue;
    }

    // A sub-member already covered to this date or beyond needs nothing.
    // Comparing cover rather than counting terms is what makes this safe to run
    // on every save: a member who joined mid-year is not renewed twice, an
    // unchanged term re-saved adds nothing, editing a superseded term does not
    // drag anybody backwards, and a member who lapsed is picked back up.
    if (_membership_entity_term_covers_to($child, $term->end)) {
      continue;
    }

    membership_entity_term_copy_from_parent($child, $parent->mid, $term);
  }

  _membership_entity_term_report_skipped($parent, $skipped);
}

/**
 * Say who was left out of a renewal, so they can be chased or closed off.
 *
 * A renewal that silently covered fewer people than the organisation expected
 * is the failure worth guarding against here: the money has been taken, and
 * whoever took it has no reason to look. Naming them at the moment of renewal
 * is the one time somebody is certain to be looking.
 *
 * @param MembershipEntity $parent
 *   The membership that was renewed.
 * @param array $skipped
 *   Sub-memberships not carried forward, keyed by mid.
 */
function _membership_entity_term_report_skipped(MembershipEntity $parent, array $skipped) {
  if (empty($skipped)) {
    return;
  }

  $statuses = membership_entity_get_status_list();
  $items = array();
  foreach ($skipped as $child) {
    $items[] = t('@id — @name (@status)', array(
      '@id' => $child->member_id,
      '@name' => membership_entity_member_name($child),
      '@status' => $statuses[(int) $child->status],
    ));
  }

  backdrop_set_message(format_plural(count($skipped),
    'One sub-member of @parent was not renewed, because their membership has been ended rather than allowed to lapse:',
    '@count sub-members of @parent were not renewed, because their memberships have been ended rather than allowed to lapse:',
    array('@parent' => $parent->member_id)) . theme('item_list', array('items' => $items)), 'warning');
}

/**
 * Whether a membership is already covered to at least a given date.
 *
 * Note membership_entity_term_get_current() cannot answer this on its own: it
 * takes the first row whose span contains today, and renewing early leaves two
 * overlapping terms current at once, so which one comes back is arbitrary. The
 * furthest end date across the membership's active terms is the honest measure
 * of how far its cover reaches.
 *
 * @param MembershipEntity $membership
 *   The membership to measure.
 * @param string|null $end
 *   The end date to compare against, or NULL for a lifetime term, which no
 *   fixed date can match.
 *
 * @return bool
 *   TRUE if the membership is already covered that far.
 */
function _membership_entity_term_covers_to(MembershipEntity $membership, $end) {
  // Nothing outlasts a lifetime term, so only another one will do.
  $furthest = db_query('SELECT MAX(end) FROM {membership_entity_term} WHERE mid = :mid AND status = :status', array(
    ':mid' => $membership->mid,
    ':status' => MEMBERSHIP_ENTITY_ACTIVE,
  ))->fetchField();

  $lifetime = (bool) db_query_range('SELECT 1 FROM {membership_entity_term} WHERE mid = :mid AND status = :status AND term = :term', 0, 1, array(
    ':mid' => $membership->mid,
    ':status' => MEMBERSHIP_ENTITY_ACTIVE,
    ':term' => 'lifetime',
  ))->fetchField();

  if ($lifetime) {
    return TRUE;
  }
  if (empty($end)) {
    return FALSE;
  }

  return !empty($furthest) && strtotime($furthest) >= strtotime($end);
}

/**
 * Implements hook_membership_entity_uncoupled().
 *
 * A membership whose parent paid for it holds no term of its own, and its
 * status sits permanently at active — harmless while the parent governs it, but
 * a membership that never expires once the parent is removed. Give it the
 * parent's current term so that it carries on from where the parent left off
 * and renews on its own thereafter.
 *
 * @param MembershipEntity $membership
 *   The membership that has just been detached from its parent.
 * @param int $old_pid
 *   The membership id of the parent it was detached from.
 */
function membership_entity_term_membership_entity_uncoupled($membership, $old_pid) {
  // Only a membership with no term of its own needs one. Anything else was
  // already renewing separately.
  $terms = membership_entity_term_load_by_membership($membership, TRUE);
  if (!empty($terms)) {
    return;
  }

  if (!membership_entity_term_copy_from_parent($membership, $old_pid)) {
    return;
  }

  backdrop_set_message(t('Membership %member_id has been given its own term, ending on the same date as the membership it has left. It renews separately from now on.', array(
    '%member_id' => $membership->member_id,
  )));
}

/**
 * Give a membership a term matching its parent's current one.
 *
 * The start and the length are copied, never the end date: MembershipEntityTerm
 * recalculates end from start plus term on every save, so an assigned end is
 * silently discarded. Same start and same length reproduces the same end.
 *
 * @param MembershipEntity $membership
 *   The membership to give a term to. It must already be saved.
 * @param int $parent_mid
 *   The membership id to copy the term from.
 * @param object $parent_term
 *   The specific term to copy. Defaults to the parent's current term, which is
 *   what the joining and uncoupling paths want; the renewal path passes the
 *   term it has just saved, because two overlapping terms can both be current
 *   and picking between them by date is guesswork.
 *
 * @return MembershipEntityTerm|false
 *   The term created, or FALSE where the parent has no current term to copy.
 */
function membership_entity_term_copy_from_parent(MembershipEntity $membership, $parent_mid, $parent_term = NULL) {
  if (empty($parent_term)) {
    $parent_term = membership_entity_term_get_current($parent_mid);
  }
  if (empty($parent_term)) {
    return FALSE;
  }

  $term = membership_entity_term_create(array(
    'mid' => $membership->mid,
    'membership_entity_type' => $membership->type,
    'term' => $parent_term->term,
    'start' => $parent_term->start,
    'status' => $parent_term->status,
  ));
  membership_entity_term_save($term);

  return $term;
}

/**
 * Implements hook_membership_entity_create().
 */
function membership_entity_term_membership_entity_create($membership) {
  // Add an empty list of terms.
  $membership->terms = array();
}

/**
 * Implements hook_membership_entity_load().
 */
function membership_entity_term_membership_entity_load($memberships) {
  // Load membership terms.
  foreach ($memberships as &$membership) {
    $membership->terms = membership_entity_term_load_by_membership($membership);
  }
}

/**
 * Implements hook_field_info_alter().
 */
function membership_entity_term_field_info_alter(&$info) {
  // Add the 'membership_entity_term_renew_form' instance setting to all field
  // types.
  foreach ($info as $field_type => $field_type_info) {
    $info[$field_type]['instance_settings']['membership_entity_term_renew_form'] = FALSE;
  }
}

/**
 * Ensure a membership type's terms carry a note field.
 *
 * "Renewed 5 August, late because of illness" is the line an organisation
 * actually wants in its records, and without somewhere to put it the ledger can
 * only ever show dates. Created rather than documented because a site builder
 * has no reason to guess that terms are fieldable at all — the entity has been
 * fieldable since the beginning and every bundle shipped with no fields.
 *
 * Does nothing where the field is already there, so it is safe to call on every
 * type save, and a site that deletes the field is not given it back.
 *
 * @param string $bundle
 *   The membership type whose terms should have the field.
 */
function membership_entity_term_add_note_field($bundle) {
  $field_name = 'membership_term_note';

  if (!field_info_field($field_name)) {
    field_create_field(array(
      'field_name' => $field_name,
      'type' => 'text_long',
      'entity_types' => array('membership_entity_term'),
      'cardinality' => 1,
    ));
  }

  if (field_info_instance('membership_entity_term', $field_name, $bundle)) {
    return;
  }

  field_create_instance(array(
    'field_name' => $field_name,
    'entity_type' => 'membership_entity_term',
    'bundle' => $bundle,
    'label' => t('Note'),
    'description' => t('Anything worth recording about this term — why it started late, what was agreed, who authorised it.'),
    'required' => FALSE,
    'settings' => array(
      // Off on the public join form; this is a record keeper's field.
      'membership_entity_join_form' => 0,
      'membership_entity_term_renew_form' => 0,
    ),
    'widget' => array(
      'type' => 'text_textarea',
      'weight' => 20,
    ),
  ));
}

/**
 * Implements hook_field_extra_fields().
 */
function membership_entity_term_field_extra_fields() {
  $fields = array();
  foreach (membership_entity_get_bundles() as $type) {
    $fields['membership_entity'][$type->type] = array(
      'form' => array(
        'membership_term' => array(
          'label' => t('Membership term fields'),
          'description' => t('Term fields on join and renew forms.'),
          'weight' => 99,
        ),
      ),
      'display' => array(
        'membership_terms' => array(
          'label' => t('Membership term list'),
          'description' => t('A list of terms for the membership.'),
          // Below the membership's own details rather than above them. At -99
          // the ledger rendered before the member it belongs to, which read as
          // an accident and was never what anybody would order it by hand. A
          // site that has saved its own display keeps whatever it chose.
          'weight' => 10,
        ),
      ),
    );

    // Term fields.
    $fields['membership_entity_term'][$type->type] = array(
      'form' => array(
        'start' => array(
          'label' => t('Start date'),
          'description' => t('The term start date.'),
          'weight' => 0,
        ),
        'term' => array(
          'label' => t('Term Length'),
          'description' => t('The term length options.'),
          'weight' => 1,
        ),
        'status' => array(
          'label' => t('Status'),
          'description' => t('The term status.'),
          'weight' => 2,
        ),
        'modifiers' => array(
          'label' => t('Modifiers'),
          'description' => t('Term modifiers (eg. +1 month)'),
          'weight' => 3,
        ),
      ),
    );
  }
  return $fields;
}

/**
 * Implements hook_membership_entity_view().
 */
function membership_entity_term_membership_entity_view($membership, $view_mode, $langcode) {
  // Declared as an extra field, so it can be moved, hidden or turned off from
  // Manage Display like anything else on the page. It used to be emitted with
  // no weight at all, which is why the ledger rendered above the identity of
  // the member it belonged to.
  $display = field_extra_fields_get_display('membership_entity', $membership->type, $view_mode);

  if (!isset($display['membership_terms']) || !empty($display['membership_terms']['visible'])) {
    $settings = membership_entity_get_bundle_settings($membership->type);
    list($view_name, $display_id) = _membership_entity_term_ledger_view($settings);

    $membership->content['membership_terms'] = array(
      '#markup' => views_embed_view($view_name, $display_id, $membership->mid),
      '#weight' => isset($display['membership_terms']['weight']) ? $display['membership_terms']['weight'] : 10,
    );
  }

  if ($view_mode == 'account' && membership_entity_access('renew', $membership)) {
    // Add a renew link.
    $membership->content['links']['membership_entity']['#links']['renew'] = array(
      'title' => t('Renew membership'),
      'href' => 'membership/' . $membership->mid . '/renew',
      'attributes' => array(
        'title' => t('Renew membership @member_id.', array('@member_id' => $membership->member_id)),
      ),
      'html' => FALSE,
    );
  }
}

/**
 * Implements hook_membership_entity_delete().
 */
function membership_entity_term_membership_entity_delete($membership) {
  // Remove membership terms.
  db_delete('membership_entity_term')
    ->condition('mid', $membership->mid)
    ->execute();
  watchdog('membership_entity_term', 'Deleted terms for membership %member_id', array('%member_id' => $membership->member_id));
}

/**
 * Implements hook_theme().
 */
function membership_entity_term_theme() {
  return array(
    'membership_entity_term_available_term_lengths_element' => array(
      'render element' => 'element',
    ),
    'membership_entity_term_modifiers_element' => array(
      'render element' => 'element',
    ),
    'membership_entity_term_modifiers' => array(
      'variables' => array(
        'modifiers' => array(),
      ),
    ),
  );
}

/**
 * Implements hook_form_alter().
 */
function membership_entity_term_form_alter(&$form, &$form_state, $form_id) {
  switch ($form_id) {
    case 'membership_entity_edit_form':
    case 'membership_entity_join_form':
      if (isset($form['#membership_entity'])) {
        form_load_include($form_state, 'inc', 'membership_entity_term', 'membership_entity_term.pages');
        membership_entity_term_create_form($form, $form_state);
      }
      break;
  }
}

/**
 * The view and display used for a membership type's term ledger.
 *
 * @param array $settings
 *   The membership type's settings.
 *
 * @return array
 *   The view name and display id.
 */
function _membership_entity_term_ledger_view(array $settings) {
  $value = !empty($settings['term_list_view']) ? $settings['term_list_view'] : 'membership_entity_terms:term_list';
  $parts = explode(':', $value);

  return array(
    $parts[0],
    isset($parts[1]) ? $parts[1] : 'default',
  );
}

/**
 * Implements hook_membership_entity_settings_alter().
 */
function membership_entity_term_membership_entity_settings_alter(&$form, &$form_state, $data) {
  form_load_include($form_state, 'inc', 'membership_entity_term', 'membership_entity_term.pages');
  _membership_entity_term_settings_form($form, $form_state, $data);
}

/**
 * Implements hook_form_FORM_ID_alter() for field_uid_field_edit_form().
 *
 * Add a checkbox for the 'membership_entity_term_renew_form' setting.
 */
function membership_entity_term_form_field_ui_field_edit_form_alter(&$form, &$form_state, $form_id) {
  $instance = $form['#instance'];
  if (in_array($instance['entity_type'], array('membership_entity', 'membership_entity_term')) && !$form['#field']['locked']) {
    $form['instance']['settings']['membership_entity_term_renew_form'] = array(
      '#type' => 'checkbox',
      '#title' => t('Display on renew form.'),
      '#default_value' => !empty($instance['settings']['membership_entity_term_renew_form']),
      '#weight' => $form['instance']['settings']['membership_entity_join_form']['#weight'] + .1,
    );

    if ($instance['entity_type'] == 'membership_entity_term') {
      $form['instance']['settings']['membership_entity_term_renew_form'] += array(
        '#description' => t("This is compulsory for 'required' fields."),
        '#default_value' => $instance['settings']['membership_entity_join_form'] || $instance['required'],
        '#states' => array(
          'enabled' => array('input[name="instance[required]"]' => array('checked' => FALSE)),
        ),
        '#attached' => array(
          'js' => array(backdrop_get_path('module', 'membership_entity_term') . '/js/membership-entity-term.js'),
        ),
      );

      array_unshift($form['#submit'], 'membership_entity_term_form_field_ui_field_edit_form_submit');
    }
  }
}

/**
 * Additional submit handler for the 'Edit field instance' form.
 *
 * Make sure the 'membership_entity_renew_form' setting is set for
 * required fields.
 */
function membership_entity_term_form_field_ui_field_edit_form_submit($form, &$form_state) {
  $instance = $form_state['values']['instance'];
  if (!empty($instance['required'])) {
    form_set_value($form['instance']['settings']['membership_entity_renew_form'], 1, $form_state);
  }
}

/**
 * Implements hook_action_info().
 */
function membership_entity_term_action_info() {
  return array(
    'membership_entity_term_renew_sub_member_action' => array(
      'type' => 'membership_entity',
      'label' => t('Mark as renewed'),
      'configurable' => FALSE,
    ),
  );
}

/**
 * Actions callback: renew a sub-member onto the term its parent is paying for.
 *
 * The act this exists for is an association handing over the list of who has
 * paid it this year. The list is never the whole membership, so the renewal
 * cannot be applied to everybody as a body; it is applied one member at a time,
 * to exactly the people named. Whoever is not named is left entirely alone —
 * their existing term runs out on its own date and expiry takes its ordinary
 * course. That is the difference between somebody who has lapsed and somebody
 * who has resigned, and it is worth keeping, because a lapsed member very often
 * comes back and should come back to the same record.
 *
 * No new term arithmetic lives here. The term is the parent's, copied down by
 * the same function the automatic cascade uses, so the two routes cannot drift
 * apart and a member renewed by hand is indistinguishable from one renewed as
 * part of a group.
 *
 * Safe to run more than once, and safe to run over a selection that includes
 * people already dealt with: a sub-member already covered to the parent's end
 * date is left untouched rather than given a second term. That matters because
 * a roster of any size gets worked through in sittings, with the same rows
 * inevitably selected twice.
 *
 * @param MembershipEntity $membership
 *   The sub-member being marked as renewed.
 * @param array $context
 *   Action context. Unused.
 */
function membership_entity_term_renew_sub_member_action($membership, $context = array()) {
  // Bulk operations hand rows over as whatever the view produced, which is not
  // always a MembershipEntity, and every helper below is type hinted.
  if (!($membership instanceof MembershipEntity)) {
    $membership = membership_entity_create_from_stdclass($membership);
  }

  // The action is only meaningful where somebody above is paying. A membership
  // that renews separately has its own term to buy and its own renewal form to
  // buy it on; handing it the parent's term would give away cover nobody has
  // paid for.
  if (empty($membership->pid) || !membership_entity_child_inherits_terms($membership)) {
    _membership_entity_term_renew_action_warn('not_covered', $membership->pid, t('%id is not paid for by a membership above it, so it cannot be renewed this way. It renews on its own membership page.', array(
      '%id' => $membership->member_id,
    )));
    return;
  }

  if (!membership_entity_term_renew_sub_member_access($membership)) {
    _membership_entity_term_renew_action_warn('denied', $membership->pid, t('You do not have permission to renew sub-members of that membership.'));
    return;
  }

  // Renewing the parent is what buys the cover, so it has to have happened
  // first. Saying so is the whole point of the check — copy_from_parent simply
  // returns FALSE, which on a bulk run would look like nothing at all.
  $parent_term = _membership_entity_term_furthest($membership->pid);
  if (empty($parent_term)) {
    _membership_entity_term_renew_action_warn('no_parent_term', $membership->pid, t('The membership above these sub-members has no current term, so there is nothing to renew them onto. Renew it first, then mark its sub-members as renewed.'));
    return;
  }

  if (_membership_entity_term_covers_to($membership, $parent_term->end)) {
    return;
  }

  membership_entity_term_copy_from_parent($membership, $membership->pid, $parent_term);
}

/**
 * The active term carrying a membership's cover furthest forward.
 *
 * Deliberately not membership_entity_term_get_current(), which asks a different
 * question — what covers the membership *today*. An association that renews
 * before its date runs out holds two active terms at once, and the current one
 * is then the OLD one: copying that down would hand every sub-member the cover
 * they already had and report a successful renewal for doing nothing. The
 * automatic cascade never meets this because it is handed the term that was
 * just saved; anything working from the parent afterwards has to go looking.
 *
 * @param int $mid
 *   The membership id.
 *
 * @return object|false
 *   The active term reaching furthest into the future, or FALSE if there is
 *   none. A lifetime term wins outright — nothing outlasts it, and it carries
 *   no end date to compare.
 */
function _membership_entity_term_furthest($mid) {
  $id = db_query_range('SELECT id FROM {membership_entity_term} WHERE mid = :mid AND status = :status AND term = :term', 0, 1, array(
    ':mid' => $mid,
    ':status' => MEMBERSHIP_ENTITY_ACTIVE,
    ':term' => 'lifetime',
  ))->fetchField();

  if (!$id) {
    $id = db_query_range('SELECT id FROM {membership_entity_term} WHERE mid = :mid AND status = :status AND end IS NOT NULL ORDER BY end DESC', 0, 1, array(
      ':mid' => $mid,
      ':status' => MEMBERSHIP_ENTITY_ACTIVE,
    ))->fetchField();
  }

  return $id ? membership_entity_term_load($id) : FALSE;
}

/**
 * Whether the current user may renew a given sub-member.
 *
 * Repeats the check rather than leaning on the view's own access, because a
 * bulk operations form is configured separately from the permissions and the
 * two drift. An association secretary reaches this through the roster tab on
 * their own membership; a site administrator reaches it from anywhere.
 *
 * @param MembershipEntity $membership
 *   The sub-member being renewed.
 *
 * @return bool
 *   TRUE if the renewal may proceed.
 */
function membership_entity_term_renew_sub_member_access(MembershipEntity $membership) {
  if (user_access('administer membership terms') || user_access('administer memberships')) {
    return TRUE;
  }

  return membership_entity_manages_sub_membership('edit', $membership);
}

/**
 * Say once per parent what stopped a bulk renewal, rather than once per row.
 *
 * Every reason a row is refused is a property of the membership above it, so on
 * a roster of two hundred the same sentence would otherwise be printed two
 * hundred times and bury everything else on the page.
 *
 * @param string $reason
 *   A key identifying the kind of refusal.
 * @param int $pid
 *   The parent membership id, or empty where there is none.
 * @param string $message
 *   The message to show the first time this reason arises for this parent.
 */
function _membership_entity_term_renew_action_warn($reason, $pid, $message) {
  $seen = &backdrop_static(__FUNCTION__, array());
  $key = $reason . ':' . (int) $pid;
  if (isset($seen[$key])) {
    return;
  }

  $seen[$key] = TRUE;
  backdrop_set_message($message, 'warning');
}

/**
 * Implements hook_views_api().
 */
function membership_entity_term_views_api() {
  return array(
    'api' => 3,
    'path' => backdrop_get_path('module', 'membership_entity_term') . '/views',
  );
}

/**
 * Implements hook_preprocess_views_view().
 */
function membership_entity_term_preprocess_views_view(&$vars) {
  $view = $vars['view'];
  if ($view->name == 'membership_entity_terms') {
    backdrop_add_css(backdrop_get_path('module', 'membership_entity_term') . '/css/membership_entity_term.css');
  }
}

/**
 * Convert a stdClass object to an instance of MembershipEntityTerm.
 *
 * Shallow copies all properties of $object to a new
 * MembershipEntityTerm instance.
 *
 * @param object $object
 *   The object to convert.
 *
 * @return MembershipEntityTerm
 *   A new instance of MembershipEntityTerm with all properties copied from
 *   $object.
 */
function membership_entity_term_create_from_stdclass($object) {
  $term = membership_entity_term_create();
  foreach (get_object_vars($object) as $key => $value) {
    $term->{$key} = $value;
  }
  return $term;
}

/**
 * Create a new membership entity term with default values.
 *
 * @param optional|array $values
 *   An associative array of values to override the defaults.
 *
 * @return MembershipEntityTerm
 *   The (unsaved) membership term object.
 */
function membership_entity_term_create($values = array()) {
  return entity_create('membership_entity_term', $values);
}

/**
 * Load a single membership term object.
 */
function membership_entity_term_load($id = NULL, $reset = FALSE) {
  $terms = membership_entity_term_load_multiple(array($id), array(), $reset);
  return is_array($terms) ? reset($terms) : FALSE;
}

/**
 * Load all terms for a given membership.
 */
function membership_entity_term_load_by_membership($membership, $reset = FALSE) {
  $controller = entity_get_controller('membership_entity_term');
  if ($reset) {
    $controller->resetCache();
  }
  return $controller->loadByMembership($membership);
}

/**
 * Returns the start date of the first membership term.
 *
 * @param MembershipEntity $membership
 *   A fully loaded membership object.
 *
 * @return DateTimeInterface|false
 *   The start date of the first term. Use date_format_date() to create
 *   a formatted date string. FALSE if there are no terms for the membership.
 */
function membership_entity_term_get_join_date(MembershipEntity $membership) {
  // Find and return the first term start date.
  if (!empty($membership->terms)) {
    $terms = $membership->terms;
    uasort($terms, '_membership_entity_term_sort_by_start_date');
    $first = reset($terms);
    return new BackdropDateTime($first->start, new DateTimezone($first->timezone));
  }
  return FALSE;
}

/**
 * Returns the end date of the last membership term.
 *
 * @param MembershipEntity $membership
 *   A fully loaded membership object or mid.
 *
 * @return DateTimeInterface
 *   The end date of the latest active term. Use date_format_date() to create
 *   a formatted date string. FALSE if there are no active or expired terms for
 *   the membership or the latest term is a lifetime term.
 */
function membership_entity_term_get_expiration_date(MembershipEntity $membership) {
  // Find and return the latest active term end date.
  if (!empty($membership->terms)) {
    $terms = array_filter($membership->terms, '_membership_entity_term_array_filter_expiration_status');
    if (empty($terms)) {
      return FALSE;
    }

    uasort($terms, '_membership_entity_term_sort_by_end_date');
    $last = end($terms);
    if ($last->term == 'lifetime') {
      return FALSE;
    }
    return new BackdropDateTime($last->end, new DateTimezone($last->timezone));
  }
  return FALSE;
}

/**
 * Get the current term for a membership.
 *
 * @param MembershipEntity|int $mid
 *   A membership object or mid.
 *
 * @return MembershipEntityTerm
 *   The loaded membership term object or FALSE if there is no current term.
 */
function membership_entity_term_get_current($mid) {
  // Support mid or fully loaded membership.
  if (is_object($mid)) {
    $mid = $mid->mid;
  }

  if ($id = db_query('SELECT id FROM {membership_entity_term} t WHERE mid = :mid AND (start <= :now AND end >= :now) LIMIT 1',
    array(
      ':mid' => $mid,
      ':now' => date_format_date(date_now('UTC'), 'custom', DATE_FORMAT_DATETIME),
    ))->fetchField()) {
    return membership_entity_term_load($id);
  }
  return FALSE;
}

/**
 * Loads multiple membership objects.
 */
function membership_entity_term_load_multiple($ids = FALSE, $conditions = array(), $reset = FALSE) {
  return entity_load('membership_entity_term', $ids, $conditions, $reset);
}

/**
 * Delete a membership term.
 */
function membership_entity_term_delete($id) {
  membership_entity_term_delete_multiple(array($id));
}

/**
 * Delete multiple membership terms.
 */
function membership_entity_term_delete_multiple($ids) {
  entity_delete_multiple('membership_entity_term', $ids);
}

/**
 * Save a membership term.
 */
function membership_entity_term_save($term) {
  return $term->save('membership_entity_term');
}

/**
 * Filter terms that are not active or expired.
 *
 * Callback for array_filter() within
 * membership_entity_term_get_expiration_date().
 *
 * @param MembershipEntityTerm $term
 *   The membership term to check status.
 *
 * @return bool
 *   TRUE if the term is active or expired.
 */
function _membership_entity_term_array_filter_expiration_status(MembershipEntityTerm $term) {
  return ($term->status == MEMBERSHIP_ENTITY_ACTIVE || $term->status == MEMBERSHIP_ENTITY_EXPIRED);
}

/**
 * Sort by term start date.
 *
 * Callback for usort() within membership_entity_term_get_join_date().
 *
 * @param MembershipEntityTerm $a
 *   The first membership entity term to sort against.
 * @param MembershipEntityTerm $b
 *   The second membership entity term to sort against.
 *
 * @return MembershipEntityTerm[]
 *   An array of sorted terms by start date.
 */
function _membership_entity_term_sort_by_start_date(MembershipEntityTerm $a, MembershipEntityTerm $b) {
  $c = isset($a->start) ? $a->start : '';
  $d = isset($b->start) ? $b->start : '';

  if ($c == $d) {
    return 0;
  }
  return ($c < $d) ? -1 : 1;
}

/**
 * Sort by term end date.
 *
 * Callback for usort() within membership_entity_term_get_expiration_date().
 *
 * @param MembershipEntityTerm $a
 *   The first term object to sort against.
 * @param MembershipEntityTerm $b
 *   The second term object to sort against.
 *
 * @return MembershipEntityTerm[]
 *   An array of sorted terms by end date.
 */
function _membership_entity_term_sort_by_end_date(MembershipEntityTerm $a, MembershipEntityTerm $b) {
  // Lifetime terms trump all.
  if ($a->term == 'lifetime') {
    return 1;
  }

  if ($b->term == 'lifetime') {
    return -1;
  }

  $c = isset($a->end) ? $a->end : '';
  $d = isset($b->end) ? $b->end : '';

  if ($c == $d) {
    return 0;
  }
  return ($c < $d) ? -1 : 1;
}

/**
 * Sort terms by weight value.
 *
 * Callback for usort() within
 * theme_membership_entity_term_available_term_lengths_element().
 */
function _membership_entity_term_sort_items_by_weight($a, $b) {
  $a_weight = (is_array($a) && isset($a['weight']['#value']) ? $a['weight']['#value'] : 0);
  $b_weight = (is_array($b) && isset($b['weight']['#value']) ? $b['weight']['#value'] : 0);
  return $a_weight - $b_weight;
}

/**
 * Helper to correctly handle relative modifiers to a date object.
 *
 * PHP date handling does not correctly support month operations for months
 * with a different number of days or leap years.
 *
 * @param DateTime $date
 *   The date object to modify.
 * @param string $modifier
 *   The relative date modifier.
 *
 * @return DateTime
 *   The modified date object.
 */
function _membership_entity_term_modify_date(DateTime $date, $modifier) {
  $start_day = $date->format('j');
  $date->modify($modifier);

  // Check if we are dealing with months or leap years.
  if (preg_match('/^[\+-]?(\d+ (month|year)s?)$/i', $modifier)) {
    $end_day = $date->format('j');
    if ($start_day != $end_day) {
      $date->modify('last day of last month');
    }
  }

  return $date;
}

/**
 * Returns HTML for the available term lengths form element.
 */
function theme_membership_entity_term_available_term_lengths_element($variables) {
  $element = $variables['element'];
  $order_class = $element['#id'] . '-term-weight';

  // Sort items according to weight.
  $items = array();
  foreach (element_children($element) as $key) {
    $items[] = &$element[$key];
  }

  if (!empty($items)) {
    usort($items, '_membership_entity_term_sort_items_by_weight');
  }

  $table_id = 'available-term-lengths';
  $header = array(
    t('Available Term Lengths'),
    t('Example (relative to now)'),
    '',
  );
  $rows = array();

  if (!empty($items)) {
    $header[] = t('Order');

    // Add the items as table rows.
    foreach ($items as $key => $item) {
      $item['weight']['#attributes']['class'][] = $order_class;
      $rows[] = array(
        'data' => array(
          // We use #type => value instead of markup so that term_length will
          // be included in $form_state['values'].
          array('data' => $item['term_length']['#value']),
          array('data' => backdrop_render($item['example'])),
          array('data' => backdrop_render($item['remove'])),
          array('data' => backdrop_render($item['weight']), 'class' => array('term-weight')),
        ),
        'class' => array('draggable'),
      );
    }
    backdrop_add_tabledrag($table_id, 'order', 'sibling', $order_class);
  }
  else {
    $rows[]['data'] = array(
      array(
        'data' => t('Select a term length and click "Add term length" to add it to the list of available term lengths.'),
        'colspan' => 3,
      ),
    );
  }

  return theme('table', array(
    'header' => $header,
    'rows' => $rows,
    'attributes' => array('id' => $table_id),
    'caption' => $element['#description'],
  ));
}

/**
 * Returns HTML for the term modifiers form element.
 */
function theme_membership_entity_term_modifiers_element($variables) {
  $element = $variables['element'];
  $header = array(
    array('data' => t('Modifier'), 'colspan' => 2),
  );
  $rows = array();
  $items = element_children($element);
  if (!empty($items)) {
    foreach ($items as $key) {
      $rows[] = array(
        'data' => array(
          // We use #type => value instead of markup so that the modifier will
          // be included in $form_state['values'].
          array('data' => $element[$key]['value']['#value']),
          array('data' => backdrop_render($element[$key]['remove'])),
        ),
      );
    }
  }
  else {
    $rows[]['data'] = array(
      array(
        'data' => t('Select a modifier and click "Add modifier" to add it to the list.'),
        'colspan' => 2,
      ),
    );
  }

  return theme('table', array(
    'header' => $header,
    'rows' => $rows,
    'attributes' => array('id' => 'term-modifiers'),
  ));
}

/**
 * Returns HTML for a list of term modifiers.
 */
function theme_membership_entity_term_modifiers($variables) {
  backdrop_add_css(backdrop_get_path('module', 'membership_entity_term') . '/membership_entity_term.css');
  $modifiers = $variables['modifiers'];
  $output = '<div class="membership-entity-term-modifiers">';
  $output .= implode('<br />', array_map('check_plain', $modifiers));
  $output .= '</div>';
  return $output;
}
