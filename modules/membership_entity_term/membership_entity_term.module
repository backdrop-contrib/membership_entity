/**
 * Implements hook_menu_alter().
 */
function membership_entity_term_menu_alter(&$items) {
  // The renewals tab is a Views page, and a view can only express access as a
  // permission. What governs this one is a relationship — whether the person
  // looking heads the membership whose sub-members are listed — so the access
  // callback is replaced with one that can say so. The path carries a bare %
  // rather than a loader, so the callback is handed a raw membership id.
  if (isset($items['membership/%/renewals'])) {
    $items['membership/%/renewals']['access callback'] = 'membership_entity_term_renewals_access';
    $items['membership/%/renewals']['access arguments'] = array(1);
  }

  // Adjust the Field UI tabs on
  // admin/memberships/types/manage/[membership-type].
  if (module_exists('membership_entity_type')) {
    $items['admin/memberships/types/manage/%membership_entity_term_type/terms/fields']['title'] = 'Term fields';
    $items['admin/memberships/types/manage/%membership_entity_term_type/terms/fields']['weight'] = 3;
    $items['admin/memberships/types/manage/%membership_entity_term_type/terms/display']['title'] = 'Term display';
    $items['admin/memberships/types/manage/%membership_entity_term_type/terms/display']['weight'] = 4;
  }
  else {
    $items['admin/memberships/types/manage/membership/terms/fields']['title'] = 'Term fields';
    $items['admin/memberships/types/manage/membership/terms/fields']['weight'] = 3;
    $items['admin/memberships/types/manage/membership/terms/display']['title'] = 'Term display';
    $items['admin/memberships/types/manage/membership/terms/display']['weight'] = 4;
  }
}

/**
 * Whether the renewals tab should appear on a membership, and for whom.
 *
 * Absent rather than present-and-refused wherever it would mean nothing: on a
 * membership that cannot have sub-members, and on one whose type renews its
 * sub-members automatically, where there is no list to mark off and the tab
 * would invite somebody to do work that has already been done for them.
 *
 * @param int $mid
 *   The membership id from the path.
 *
 * @return bool
 *   TRUE if the tab should be shown.
 */
function membership_entity_term_renewals_access($mid) {
  if (!$membership = membership_entity_load($mid)) {
    return FALSE;
  }

  // Two levels only, so a sub-member never has sub-members of its own.
  if (!empty($membership->pid) || !membership_entity_renews_from_roster($membership)) {
    return FALSE;
  }

  if (user_access('administer membership terms') || user_access('administer memberships')) {
    return TRUE;
  }

  // The association secretary reaching their own roster. The permission is
  // keyed on this membership's own type, because the capability comes from
  // heading it — which is the same rule the sub-member permissions already
  // follow, seen from the other end.
  return $membership->uid == $GLOBALS['user']->uid
    && user_access($membership->type . ' edit sub-memberships');
}

/**
 * Implements hook_menu_link_alter().
 */
function membership_entity_term_menu_link_alter(&$link) {
  // Force the Renew link to appear on the top level of the 'user-menu' menu.
  if ($link['link_path'] == 'user/renew' && $link['module'] == 'system' && empty($link['customized'])) {
    $link['plid'] = 0;
  }
}

