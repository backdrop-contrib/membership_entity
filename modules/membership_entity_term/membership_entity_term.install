<?php

/**
 * @file
 * Install, uninstall, and update hooks for the membership_entity_term module.
 */

/**
 * Give every membership type's terms a note field.
 */
function membership_entity_term_update_1000() {
  backdrop_load('module', 'membership_entity_term');

  foreach (array_keys(membership_entity_get_bundles()) as $bundle) {
    // The bundle was previously created under a prefixed name that nothing
    // referred to. Make sure the real one exists before attaching to it.
    field_attach_create_bundle('membership_entity_term', $bundle);
    membership_entity_term_add_note_field($bundle);
  }
}

/**
 * Install the renewals view on sites already running this module.
 *
 * A view shipped in a module's config directory is only copied into active
 * config when the module is installed, so an existing site gains nothing from
 * one being added later. The tab it provides is registered by the view, which
 * means without this the menu item does not exist either and the feature is
 * simply absent, with nothing to say why.
 */
function membership_entity_term_update_1001() {
  $name = 'views.view.membership_entity_renewals';

  // Never overwrite a site that already has it — most likely because somebody
  // built their own before this shipped, and theirs is the one in use.
  if (config($name)->isNew()) {
    config_install_default_config('membership_entity_term', $name);
    menu_rebuild();
  }
}

/**
 * Implements hook_schema().
 */
function membership_entity_term_schema() {
  $schema['membership_entity_term'] = array(
    'description' => 'The base table for membership terms.',
    'fields' => array(
      'id' => array(
        'description' => 'The primary identifier for membership terms.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'mid' => array(
        'description' => 'The membership identifier.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ),
      'status' => array(
        'description' => 'Integer code indicating the membership term status.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 1,
      ),
      'term' => array(
        'description' => 'The human readable term length. eg. 1 year.',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ),
      'modifiers' => array(
        'description' => 'A serialized list of term length modifiers. eg. +1 month.',
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'serialize' => TRUE,
      ),
      'start' => array(
        'description' => 'The date when this term starts.',
        'type' => 'datetime',
        'mysql_type' => 'datetime',
        'pgsql_type' => 'timestamp without time zone',
        'sqlite_type' => 'varchar',
        'sqlsrv_type' => 'smalldatetime',
        'not null' => TRUE,
        'sortable' => TRUE,
      ),
      'end' => array(
        'description' => 'The date when this term ends.',
        'type' => 'datetime',
        'mysql_type' => 'datetime',
        'pgsql_type' => 'timestamp without time zone',
        'sqlite_type' => 'varchar',
        'sqlsrv_type' => 'smalldatetime',
        // Null value for lifetime terms.
        'not null' => FALSE,
        'sortable' => TRUE,
      ),
      'timezone' => array(
        'description' => 'The database timezone for membership term dates.',
        'type' => 'varchar',
        'length' => 50,
        // Null if no timezone handling.
        'not null' => FALSE,
      ),
      'created' => array(
        'description' => 'The Unix timestamp when this membership term was created.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
      'changed' => array(
        'description' => 'The Unix timestamp when this membership term was most recently saved.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'indexes' => array(
      'membership_entity_term_membership' => array('mid'),
      'membership_entity_term_start' => array('mid', 'start'),
      'membership_entity_term_end' => array('mid', 'end'),
      'membership_entity_term_changed' => array('changed'),
      'membership_entity_term_created' => array('created'),
    ),
    'primary key' => array('id'),
    'foreign keys' => array(
      'membership_entity_term_membership' => array(
        'table' => 'membership_entity',
        'columns' => array('mid' => 'mid'),
      ),
    ),
  );

  return $schema;
}

/**
 * Implements hook_uninstall().
 *
 * Views shipped in a module's config directory are copied into active config
 * on install and are not removed with it, so without this they outlive the
 * module and reappear, broken, in the Views listing. The terms view has always
 * been left behind; it is cleared here along with the renewals view.
 */
function membership_entity_term_uninstall() {
  foreach (array('membership_entity_terms', 'membership_entity_renewals') as $name) {
    config('views.view.' . $name)->delete();
  }
}
