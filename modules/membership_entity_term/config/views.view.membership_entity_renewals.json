                    "columns": {
                        "views_bulk_operations": "views_bulk_operations",
                        "member_id": "member_id",
                        "primary_member": "primary_member",
                        "renewal_state": "renewal_state",
                        "effective_status": "effective_status",
                        "url": "url"
                    },
                    "empty_table": true,
                    "info": {
                        "views_bulk_operations": {
                            "align": "",
