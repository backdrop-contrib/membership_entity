  return array(
    'MembershipEntity' => 'membership_entity.inc',
    'MembershipEntityController' => 'membership_entity.controller.inc',
    'MembershipEntityMetadataController' => 'membership_entity.info.inc',
    'MembershipEntityMemberIdInterface' => 'plugins/member_id/MembershipEntityMemberIdInterface.php',
    'MembershipEntityMemberIdAbstract' => 'plugins/member_id/MembershipEntityMemberIdAbstract.php',
    'MembershipEntityMemberIdBroken' => 'plugins/member_id/MembershipEntityMemberIdBroken.php',
    'MembershipEntityNumericMemberId' => 'plugins/member_id/MembershipEntityNumericMemberId.class.php',
    'MembershipEntityTokenMemberId' => 'plugins/member_id/MembershipEntityTokenMemberId.class.php',
    'MembershipEntityViewsController' => 'views/membership_entity.views.inc',
    'EntityDefaultViewsController' => 'views/membership_entity.views.inc',
    'views_handler_field_membership_primary_member' => 'views/views_handler_field_membership_primary_member.inc',
    'views_handler_field_membership_secondary_member' => 'views/views_handler_field_membership_secondary_member.inc',
    'views_handler_field_membership_link' => 'views/views_handler_field_membership_link.inc',
    'views_handler_field_membership_child_count' => 'views/views_handler_field_membership_child_count.inc',
    'views_handler_field_membership_effective_status' => 'views/views_handler_field_membership_effective_status.inc',
    //'MigrateDestinationMembershipEntity' => 'membership_entity.migrate.inc',
  );
}

