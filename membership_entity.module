/**
 * Implements hook_menu_alter().
 */
function membership_entity_menu_alter(&$items) {
  // Override user_register_access() to check if a membership is required.
  $items['user/register']['access callback'] = 'membership_entity_register_access';
}

/**
 * Check if a membership is required.
 */
function membership_entity_register_access() {
  return !config_get('membership_entity.settings','membership_entity_required') && user_register_access();
}

/**
 * Implements hook_init().
 *
 * Sends the join and renew pages to the site's own pages where configured,
 * typically a shop product that takes the subscription. Done here rather than
 * in hook_menu_alter() because membership_entity_type replaces the page
 * callbacks after ours runs, and registers a path per membership type.
 */
function membership_entity_init() {
  $path = current_path();

  if (preg_match('#^user/join(/|$)#', $path)) {
    $target = config_get('membership_entity.settings', 'join_path');
  }
  elseif (preg_match('#^user/renew(/|$)#', $path)) {
    $target = config_get('membership_entity.settings', 'renew_path');
  }
  // Administrators keep the renew form, to record a renewal paid offline.
  elseif (preg_match('#^membership/\d+/renew$#', $path) && !user_access('administer membership terms')) {
    $target = config_get('membership_entity.settings', 'renew_path');
  }

  if (!empty($target)) {
    backdrop_goto($target);
  }
}

/**
 * Implements hook_menu_link_alter().
 */
function membership_entity_menu_link_alter(&$link) {
  // Force the Join link to appear on the top level of the 'user-menu' menu.
  if ($link['link_path'] == 'user/join' && $link['module'] == 'system' && empty($link['customized'])) {
    $link['plid'] = 0;
  }
}

/**
 * Title callback for a membership page.
 */
function membership_entity_page_title($membership) {
  $statuses = membership_entity_get_status_list();
  return t('Membership @member_id@status', array(
    '@member_id' => $membership->member_id,
    '@status' => ($membership->status != MEMBERSHIP_ENTITY_ACTIVE) ? ' (' . $statuses[$membership->status] . ')' : '',
  ));
}

/**
 * Implements hook_admin_paths().
 */
function membership_entity_admin_paths() {
  return array(
    'membership/*/delete' => TRUE,
    'membership/*/edit' => TRUE,
  );
}

/**
 * Implements hook_membership_entity_insert().
 */
function membership_entity_membership_entity_insert($membership) {
  membership_entity_update_alias($membership, 'insert');
}

/**
 * Implements hook_membership_entity_update().
 */
function membership_entity_membership_entity_update($membership) {
  membership_entity_update_alias($membership, 'update');
}

/**
 * Implements hook_membership_entity_delete().
 */
function membership_entity_membership_entity_delete($membership) {
  if (module_exists('path')) {
    module_load_include('inc', 'membership_entity', 'membership_entity.path');
    membership_entity_delete_alias($membership);
  }
}

/**
 * Update a membership alias.
 */
function membership_entity_update_alias(MembershipEntity $membership, $op, $options = array()) {

  $uri = entity_uri('membership_entity', $membership);
  if (!module_exists('path')) {
    return $uri['path'];
  }

  $options += ['language' => NULL];

  module_load_include('inc', 'path');
  $path = FALSE;

  switch ($op) {
    default:
      $alias = path_generate_entity_alias($membership);
      if ($alias) {
        $path = path_save_automatic_alias("membership/{$membership->mid}", $alias, $options['language']);
      }
  }
  return $path;

}

/**
 * Implements hook_theme().
 */
function membership_entity_theme() {
  $theme_hooks = array(
    'membership_entity' => array(
      'render element' => 'membership',
      'template' => 'membership-entity',
    ),
  );

  foreach ($theme_hooks as $hook => $info) {
    $theme_hooks[$hook]['file'] = 'membership_entity.theme.inc';
  }

  return $theme_hooks;
}

/**
 * Implements hook_user_view().
 *
 * Add membership data to the user page.
 */
function membership_entity_user_view($account, $view_mode, $langcode) {
  if ($view_mode == 'full' && $memberships = membership_entity_load_by_user($account)) {
    foreach ($memberships as $type => $membership) {
      if (membership_entity_access('view', $membership)) {
        $account->content['memberships'][$type] = membership_entity_view($membership, 'account', $langcode);
      }
    }
  }
}

/**
 * Menu callback: Display a membership.
 */
function membership_entity_view($membership, $view_mode = 'full', $langcode = NULL) {
  if (!isset($langcode)) {
    $langcode = $GLOBALS['language']->langcode;
  }

  $entity_type = 'membership_entity';
  $membership->content = array();

  // Allow modules to change the view mode.
  $context = array(
    'entity_type' => $entity_type,
    'entity' => $membership,
    'langcode' => $langcode,
  );
  backdrop_alter('entity_view_mode', $view_mode, $context);

  // Add the primary membership on full membership page.
  if ($view_mode == 'full') {
    $account = !empty($membership->uid) ? user_load($membership->uid) : FALSE;
    $membership->content['uid'] = array(
      '#weight' => -10,
      'label' => array(
        '#theme_wrappers' => array('container'),
        '#attributes' => array('class' => array('membership-entity-label')),
        '#markup' => t('Primary Member:&nbsp;'),
      ),
    );

    if ($account) {
      $membership->content['uid']['link'] = array(
        '#type' => 'link',
        '#title' => format_username($account),
        '#href' => 'user/' . $account->uid,
        '#options' => array(
          'attributes' => array('class' => array('membership-entity-primary-member')),
          'html' => FALSE,
        ),
      );
    }
    else {
      // Retained past the deletion of the account it belonged to. There is
      // nobody to link to, but the record still has to say whose it was.
      $membership->content['uid']['name'] = array(
        '#theme_wrappers' => array('container'),
        '#attributes' => array('class' => array('membership-entity-primary-member', 'membership-entity-member-removed')),
        '#markup' => check_plain(membership_entity_member_name($membership)),
      );
    }
  }

  // When they joined, and how long ago that was. The joining date is stored and
  // is frequently much earlier than the oldest surviving term, so it is the only
  // place this can be read from.
  if ($view_mode == 'full' && !empty($membership->created)) {
    $membership->content['joined'] = array(
      '#weight' => -9,
      'label' => array(
        '#theme_wrappers' => array('container'),
        '#attributes' => array('class' => array('membership-entity-label')),
        '#markup' => t('Joined:&nbsp;'),
      ),
      'value' => array(
        '#theme_wrappers' => array('container'),
        '#attributes' => array('class' => array('membership-entity-joined')),
        '#markup' => t('@date (member for @duration)', array(
          '@date' => format_date($membership->created, 'date_only'),
          '@duration' => membership_entity_format_duration($membership->created),
        )),
      ),
    );
  }

  if (!empty($membership->secondary_members)) {
    $links = array();
    foreach ($membership->secondary_members as $delta => $uid) {
      $links[$delta] = array(
        'title' => format_username(user_load($uid)),
        'href' => 'user/' . $uid,
      );
    }

    $membership->content['secondary_members'] = array(
      '#weight' => -7,
      'label' => array(
        '#theme_wrappers' => array('container'),
        '#attributes' => array('class' => array('membership-entity-label')),
        '#markup' => format_plural(count($links), 'Secondary Member:', 'Secondary Members:') . '&nbsp;',
      ),
    );
    if (count($links) == 1) {
      $link = reset($links);
      $membership->content['secondary_members']['links'] = array(
        '#type' => 'link',
        '#title' => $link['title'],
        '#href' => $link['href'],
        '#options' => array(
          'attributes' => array('class' => array('membership-entity-secondary-members')),
          'html' => FALSE,
        ),
      );
    }
    else {
      $membership->content['secondary_members']['links'] = array(
        '#theme' => 'links',
        '#links' => $links,
        '#attributes' => array('class' => array('membership-entity-secondary-members')),
      );
    }
  }

  // Build custom field content.
  field_attach_prepare_view('membership_entity', array($membership->mid => $membership), $view_mode, $langcode);
  entity_prepare_view('membership_entity', array($membership->mid => $membership), $langcode);
  $membership->content += field_attach_view('membership_entity', $membership, $view_mode, $langcode);

  $membership->content['links'] = array(
    '#theme' => 'links__membership_entity',
    '#pre_render' => array('backdrop_pre_render_links'),
    '#attributes' => array('class' => array('links', 'inline')),
    '#weight' => 99,
  );
  if ($view_mode == 'account') {
    // Display the membership in a fieldset on user account pages.
    $membership->content += array(
      '#theme_wrappers' => array('fieldset'),
      '#title' => t('Membership @member_id', array(
        '@member_id' => $membership->member_id,
      )),
    );

    $links = array();
    $links['view'] = array(
      'title' => t('View full membership'),
      'href' => 'membership/' . $membership->mid,
      'attributes' => array(
        'title' => t('View membership @member_id.', array('@member_id' => $membership->member_id)),
      ),
      'html' => FALSE,
    );

    if (membership_entity_access('edit', $membership)) {
      $links['edit'] = array(
        'title' => t('Edit membership'),
        'href' => 'membership/' . $membership->mid . '/edit',
        'attributes' => array(
          'title' => t('Edit membership @member_id.', array('@member_id' => $membership->member_id)),
        ),
        'html' => FALSE,
      );
    }

    $membership->content['links']['membership_entity'] = array(
      '#theme' => 'links__membership_entity__membership_entity',
      '#links' => $links,
      '#attributes' => array('class' => array('links', 'inline')),
    );
  }

  module_invoke_all('membership_entity_view', $membership, $view_mode, $langcode);
  module_invoke_all('entity_view', $membership, 'membership_entity', $view_mode, $langcode);

  $membership->content += array('#view_mode' => $view_mode);

  $build = $membership->content;
  unset($membership->content);

  $build += array(
    '#theme' => 'membership_entity',
    '#membership_entity' => $membership,
    '#view_mode' => $view_mode,
    '#language' => $langcode,
  );

  // Invoke view and alter hooks.
  $type = 'membership_entity';
  backdrop_alter(array('membership_entity_view', 'entity_view'), $build, $type);
  return $build;
}

/**
 * Implements hook_field_info_alter().
 */
function membership_entity_field_info_alter(&$info) {
  // Add the 'membership_entity_join_form' instance setting to all field types.
  foreach ($info as $field_type => $field_type_info) {
    $info[$field_type]['instance_settings']['membership_entity_join_form'] = FALSE;

    // Any text field can be declared a membership number, which is all an
    // organisation's own numbering needs: no new field type, so the field keeps
    // working with whatever widget and importer the site already uses, and a
    // site that does not want one never sees any of this.
    if ($field_type == 'text') {
      $info[$field_type]['instance_settings']['membership_entity_member_number'] = FALSE;
      $info[$field_type]['instance_settings']['membership_entity_member_number_scope'] = 'parent';
    }
  }
}

/**
 * Implements hook_field_extra_fields().
 */
function membership_entity_field_extra_fields() {
  if (!module_exists('membership_entity_type')) {
    $fields['membership_entity']['membership'] = array(
      'form' => array(
        'user' => array(
          'label' => t('User Information'),
          'description' => t('User account fields on the join form.'),
          'weight' => -10,
        ),
        'membership' => array(
          'label' => t('Membership Information'),
          'description' => t('Site id number, primary and secondary members, status, etc.'),
          'weight' => 0,
        ),
      ),
    );
  }

  $fields['user']['user'] = array(
    'display' => array(
      'memberships' => array(
        'label' => t('Memberships'),
        'description' => t('Memberships the user belongs to.'),
        'weight' => 9999,
      ),
    ),
  );

  return $fields;
}

/**
 * Implements hook_form_FORM_ID_alter() for user_admin_settings().
 *
 * Add membership options to the account settings form.
 */
function membership_entity_form_user_admin_settings_alter(&$form, &$form_state, $form_id) {
  $form['registration_cancellation']['membership_entity_required'] = array(
    '#type' => 'checkbox',
    '#title' => t('Require a membership when a visitor creates an account.'),
    '#default_value' => config_get('membership_entity.settings', 'membership_entity_required'),
    '#description' => t('New users will be required to create a membership during registration. With this setting enabled, users must complete the join form to create an account.'),
    '#weight' => 10,
  );

  // Show our checkbox above the cancellation settings.
  if (!empty($form['registration_cancellation']['user_cancel_method'])) {
    $form['registration_cancellation']['user_cancel_method']['#weight'] = 99;
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for field_uid_field_edit_form().
 *
 * Add a checkbox for the 'membership_entity_join_form' setting.
 */
function membership_entity_form_field_ui_field_edit_form_alter(&$form, &$form_state, $form_id) {
  $instance = $form['#instance'];
  if (in_array($instance['entity_type'], array('membership_entity', 'membership_entity_term')) && !$form['#field']['locked']) {
    $form['instance']['settings']['membership_entity_join_form'] = array(
      '#type' => 'checkbox',
      '#title' => t('Display on join form.'),
      '#description' => t("This is compulsory for 'required' fields."),
      '#default_value' => $instance['settings']['membership_entity_join_form'] || $instance['required'],
      '#weight' => $form['instance']['required']['#weight'] + .1,
      '#states' => array(
        'enabled' => array('input[name="instance[required]"]' => array('checked' => FALSE)),
      ),
      '#attached' => array(
        'js' => array(backdrop_get_path('module', 'membership_entity') . '/js/membership-entity.js'),
      ),
    );

    if ($instance['entity_type'] == 'membership_entity' && $form['#field']['type'] == 'text') {
      $form['instance']['settings']['membership_entity_member_number'] = array(
        '#type' => 'checkbox',
        '#title' => t('This field is a membership number'),
        '#description' => t('Checks that no two memberships are given the same value. Use it for an organisation\'s own numbering, alongside the membership id this site issues.'),
        '#default_value' => !empty($instance['settings']['membership_entity_member_number']),
      );

      $form['instance']['settings']['membership_entity_member_number_scope'] = array(
        '#type' => 'radios',
        '#title' => t('Numbers must be unique'),
        '#options' => array(
          'parent' => t('within each household or association'),
          'site' => t('across the whole site'),
        ),
        '#default_value' => isset($instance['settings']['membership_entity_member_number_scope']) ? $instance['settings']['membership_entity_member_number_scope'] : 'parent',
        '#description' => t('Numbering within each association lets two associations both have a member 001, which is usually what an organisation of organisations wants. A membership with no parent is compared against the other memberships that have no parent.'),
        '#states' => array(
          'visible' => array(
            ':input[name="instance[settings][membership_entity_member_number]"]' => array('checked' => TRUE),
          ),
        ),
      );
    }

    array_unshift($form['#submit'], 'membership_entity_form_field_ui_field_edit_form_submit');
  }
}

/**
 * Implements hook_field_attach_validate().
 *
 * Checks the fields a site has declared to be membership numbers.
 *
 * Note this is a check and not a guarantee. Field storage supports indexes but
 * not unique keys, and a field's table holds the entity id rather than the
 * parent, so uniqueness within an association could not be a database
 * constraint however it were declared. Two people saving the same number in the
 * same instant would both pass. For numbers entered by hand on an admin screen
 * that is proportionate; if these ever become numbers that must not collide,
 * they need a real column with a composite unique key instead.
 */
function membership_entity_field_attach_validate($entity_type, $entity, &$errors) {
  if ($entity_type != 'membership_entity') {
    return;
  }

  foreach (field_info_instances('membership_entity', $entity->type) as $field_name => $instance) {
    if (empty($instance['settings']['membership_entity_member_number'])) {
      continue;
    }

    $items = field_get_items('membership_entity', $entity, $field_name);
    if (empty($items)) {
      continue;
    }

    $scope = isset($instance['settings']['membership_entity_member_number_scope'])
      ? $instance['settings']['membership_entity_member_number_scope']
      : 'parent';
    $langcode = field_language('membership_entity', $entity, $field_name);

    foreach ($items as $delta => $item) {
      if (!isset($item['value']) || trim($item['value']) === '') {
        continue;
      }

      $holder = membership_entity_member_number_holder($entity, $field_name, $item['value'], $scope);
      if (!$holder) {
        continue;
      }

      $errors[$field_name][$langcode][$delta][] = array(
        'error' => 'membership_entity_member_number_taken',
        'message' => t('%label %value is already used by membership %member_id.', array(
          '%label' => $instance['label'],
          '%value' => $item['value'],
          '%member_id' => $holder->member_id,
        )),
      );
    }
  }
}

/**
 * The membership already holding a given number, if any.
 *
 * @param object $entity
 *   The membership being saved. Deliberately not type hinted: Field API
 *   validation on this module's forms runs against a pseudo-entity cast from
 *   the submitted values (_membership_entity_form_field_validate()), which is a
 *   plain object rather than a MembershipEntity. Only mid, pid and type are
 *   read, and the pseudo-entity carries all three.
 * @param string $field_name
 *   The field carrying the number.
 * @param string $value
 *   The number entered.
 * @param string $scope
 *   'parent' to compare only against memberships sharing a parent, 'site' to
 *   compare against every membership.
 *
 * @return object|false
 *   The membership already using it, or FALSE.
 */
function membership_entity_member_number_holder($entity, $field_name, $value, $scope) {
  $table = 'field_data_' . $field_name;
  if (!db_table_exists($table)) {
    return FALSE;
  }

  $query = db_select($table, 'f');
  $query->join('membership_entity', 'm', 'm.mid = f.entity_id');
  $query->fields('m', array('mid', 'member_id'))
    ->condition('f.entity_type', 'membership_entity')
    ->condition('f.deleted', 0)
    ->condition('f.' . $field_name . '_value', trim($value))
    ->range(0, 1);

  if (!empty($entity->mid)) {
    $query->condition('m.mid', $entity->mid, '<>');
  }

  // Numbering within each association is what lets two associations both have a
  // member 001. A membership with no parent is compared against the other
  // memberships that have no parent, which keeps top level numbering unique
  // without it having to be a separate setting.
  if ($scope != 'site') {
    $query->condition('m.pid', !empty($entity->pid) ? $entity->pid : 0);
  }

  $result = $query->execute()->fetchObject();
  return $result ? $result : FALSE;
}

/**
 * Additional submit handler for the 'Edit field instance' form.
 *
 * Make sure the 'membership_entity_join_form' setting is set for
 * required fields.
 */
function membership_entity_form_field_ui_field_edit_form_submit($form, &$form_state) {
  $instance = $form_state['values']['instance'];
  if (!empty($instance['required'])) {
    form_set_value($form['instance']['settings']['membership_entity_join_form'], 1, $form_state);
  }
}

/**
 * Custom pre render to handle non-field elements.
 *
 * _field_extra_fields_pre_render() requires #type = 'form' in order to
 * respect extra field settings in hook_field_extra_fields(). This seems
 * stupid. We'll just have to do it ourselves.
 */
function _membership_entity_extra_fields_pre_render($elements) {
  $entity_type = $elements['#entity_type'];
  $bundle = $elements['#bundle'];
  $extra_fields = field_info_extra_fields($entity_type, $bundle, 'form');
  foreach ($extra_fields as $name => $settings) {
    if (isset($elements[$name])) {
      $elements[$name]['#weight'] = $settings['weight'];
    }
  }
  return $elements;
}

/**
 * Custom Field API validate handler.
 *
 * The entity_form_field_validate() assumes the entity form elements are at the
 * top level of the $form_state['values'] without regard to $form['#parents'].
 * This seems stupid. We'll just have to do it ourselves.
 */
function _membership_entity_form_field_validate($entity_type, $form, &$form_state) {
  $path = array_merge($form['#parents']);
  $key_exists = NULL;
  $values = backdrop_array_get_nested_value($form_state['values'], $path, $key_exists);
  if ($key_exists) {
    $pseudo_entity = (object) $values;
    field_attach_form_validate($entity_type, $pseudo_entity, $form, $form_state);
  }
}

/**
 * Copies values to enitty properties.
 *
 * The entity_form_submit_build_entity() assumes the entity form elements are at
 * the top level of the $form_state['values'] without regard to
 * $form['#parents']. This seems stupid. We'll just have to do it ourselves.
 */
function _membership_entity_form_submit_build_entity($entity_type, $entity, $form, &$form_state) {
  $info = entity_get_info($entity_type);
  [, , $bundle] = entity_extract_ids($entity_type, $entity);

  $path = array_merge($form['#parents']);
  $key_exists = NULL;
  $values = backdrop_array_get_nested_value($form_state['values'], $path, $key_exists);
  if ($key_exists) {
    $values_excluding_fields = $info['fieldable'] ? array_diff_key($values, field_info_instances($entity_type, $bundle)) : $values;
    foreach ($values_excluding_fields as $key => $value) {
      $entity->$key = $value;
    }

    // Invoke all specified builders for copying form values to entity
    // properties.
    if (isset($form['#entity_builders'])) {
      foreach ($form['#entity_builders'] as $function) {
        $function($entity_type, $entity, $form, $form_state);
      }
    }

    // Copy field values to the entity.
    if ($info['fieldable']) {
      field_attach_submit($entity_type, $entity, $form, $form_state);
    }
  }
}

/**
 * Wrapper to load membership bundles.
 *
 * This provides a simple list of available membership bundles without the need
 * to check if the membership_entity_type module is enabled.
 *
 * @param string $bundle
 *   (optional) Return info about a specific bundle. If not provided, return
 *   info about all bundles.
 */
function membership_entity_get_bundles($bundle = NULL) {
  if (module_exists('membership_entity_type')) {
    return membership_entity_type_get_types($bundle);
  }

  $bundles['membership'] = (object) array(
    'id' => 1,
    'type' => 'membership',
    'label' => t('Membership'),
    'description' => t('A simple membership'),
    'data' => config_get('membership_entity.settings', 'membership_entity_settings'),
  );
  if (isset($bundle)) {
    return isset($bundles[$bundle]) ? $bundles[$bundle] : FALSE;
  }
  return $bundles;
}

/**
 * Load bundle settings for a membership.
 *
 * @param string $bundle
 *   The membership bundle to load settings.
 *
 * @return array
 *   An array of bundle settings or FALSE if not configured.
 */
function membership_entity_get_bundle_settings($bundle = 'membership') {
  if (module_exists('membership_entity_type')) {
    $type = membership_entity_type_load($bundle);
    $data = $type->data;
  }
  else {
    $data = config_get('membership_entity.settings', 'membership_entity_settings');
  }

  $data['status'] = !empty($data);

  // Apply defaults.
  $data += module_invoke_all('membership_entity_bundle_settings_defaults');
  return $data;
}

/**
 * Implements hook_membership_entity_bundle_settings_defaults().
 */
function membership_entity_membership_entity_bundle_settings_defaults() {
  return array(
    'cardinality' => '1',
    'show_on_profile' => 1,
    'all_edit' => 0,
    'primary_role' => '',
    'secondary_role' => '',
    'member_id_format' => 'membership_entity_numeric_member_id',
    'member_id_settings' => array(),
    // What happens when somebody who has lapsed comes back. Reinstating keeps
    // their member number, which is what most organisations mean by "they are
    // still member 8570, they just went away for a while".
    'rejoin_policy' => 'reinstate',
    // Whether one person may hold more than one membership of this type at
    // once. Off matches how the module has always behaved; on is what a body
    // whose members belong to several branches or associations needs.
    'multiple_memberships' => 0,
    // How long a lapsed membership is kept before it may be removed. A year
    // covers the ordinary case of a member who has been chased a couple of
    // times and has not come back; organisations that must keep records for
    // longer, such as anyone running a block insurance scheme, set their own.
    'retention_period' => '1 year',
  );
}

/**
 * Return the next available member id.
 *
 * @param MembershipEntity $membership
 *   The membership object to create a new member id. Used for tokens.
 *
 * @return string
 *   The next available member id for the membership.
 */
function membership_entity_next_member_id(MembershipEntity $membership) {
  $data = membership_entity_get_bundle_settings($membership->type);
  return _membership_entity_member_id_get_instance($data['member_id_format'], $data['member_id_settings'])
    ->next($membership);
}


/**
 * Get metadata for member id plugins.
 *
 * @param int $id
 *   (optional) Return metadata on a specific member_id plugin.
 */
function membership_entity_get_member_id($id = NULL) {
  $plugins = module_invoke_all('membership_entity_member_id_info');
  if ($id) {
    return $plugins[$id] ?? [];
  }
  return $plugins;
}


/**
 * Helper to retrieve a member id plugin instance.
 *
 * @return MembershipEntityMemberIdInterface
 *   MembershipEntityMemberIDInterface object instance.
 */
function _membership_entity_member_id_get_instance($id, $settings = array()) {
  $instances = &backdrop_static(__FUNCTION__);

  if (!isset($instances[$id])) {
    $plugin = membership_entity_get_member_id($id);
    $class = membership_entity_get_plugin_class($plugin, 'class');
    $class = class_exists($class) ? $class : 'MembershipEntityMemberIdBroken';
    $instances[$id] = new $class($settings);

    // Check that plugin has implemented MembershipEntityMemberIdInterface.
    if (!in_array('MembershipEntityMemberIdInterface', class_implements($instances[$id]))) {
      $instances[$id] = new MembershipEntityMemberIdBroken($settings);
    }
  }

  return $instances[$id];
}

/**
 * Get a class from a plugin, if it exists.
 *
 * @param $plugin_definition
 *   The loaded plugin type.
 * @param $class_name
 *   The identifier of the class. For example, 'handler'.
 *
 * @return string
 *   The actual name of the class to call, or NULL if the class does not exist.
 */
function membership_entity_get_plugin_class($plugin_definition, $class_name) {

  $return = FALSE;
  if (isset($plugin_definition[$class_name])) {
    if (is_string($plugin_definition[$class_name])) {
      // Plugin uses the string form shorthand.
      $return = $plugin_definition[$class_name];
    }
    elseif (isset($plugin_definition[$class_name]['class'])) {
      // Plugin uses the verbose array form.
      $return = $plugin_definition[$class_name]['class'];
    }
  }

  return ($return && class_exists($return)) ? $return : NULL;
}

/**
 * Implements hook_membership_entity_member_id_info().
 */
function membership_entity_membership_entity_member_id_info() {
  $info['membership_entity_numeric_member_id'] = array(
    'title' => t('Numeric ID'),
    'description' => t('A simple incrementing numeric member id.'),
    'class' => 'MembershipEntityNumericMemberId',
    'path' => backdrop_get_path('module', 'membership_entity') . '/plugins/member_id',
  );

  // Registered unconditionally. The Drupal 7 original gated this on the token
  // contrib module, which does not exist for Backdrop: token_replace(),
  // token_scan(), token_get_invalid_tokens_by_context() and the token_tree
  // theme hook are all core here. The gate therefore hid the plugin on every
  // Backdrop site, leaving the numeric generator as the only choice.
  $info['membership_entity_token_member_id'] = array(
    'title' => t('Token ID'),
    'description' => t('A member id built with tokens.'),
    'class' => 'MembershipEntityTokenMemberId',
    'path' => backdrop_get_path('module', 'membership_entity') . '/plugins/member_id',
  );

  return $info;
}

/**
 * Implements hook_user_cancel().
 */
function membership_entity_user_cancel($edit, $account, $method) {
  switch ($method) {
    case 'user_cancel_block_unpublish':
      $memberships = membership_entity_load_by_user($account->uid);
      foreach ($memberships as $membership) {
        $membership->status = MEMBERSHIP_ENTITY_CANCELLED;
        membership_entity_save($membership);
      }
      break;

    case 'user_cancel_reassign':
      membership_entity_user_delete($account);
      break;
  }
}

/**
 * Implements hook_user_delete().
 */
function membership_entity_user_delete($account) {
  // Deleting the memberships below revokes their roles, and revoking a role
  // saves the user account — an account that is already midway through being
  // deleted. That is wasted work at best; at worst it fires hook_user_update()
  // for an account whose 'original' is no longer coherent, which is enough to
  // throw (content_access reads $account->original->roles unguarded) and leave
  // the membership undeleted. Record the uid so _membership_entity_update_roles()
  // leaves this account alone; its role rows go with the account anyway.
  $deleting = &backdrop_static('membership_entity_deleting_users', array());
  $deleting[$account->uid] = $account->uid;

  // Delete primary memberships — except any the retention policy is keeping.
  // Those are usually insurance or audit records, and losing them because
  // somebody tidied up a user account is exactly the accident the policy
  // exists to prevent. The account still goes; the record stays, and
  // membership_entity_form_user_cancel_confirm_form_alter() warns first.
  $memberships = membership_entity_load_by_user($account->uid);
  foreach ($memberships as $membership) {
    if (membership_entity_is_retained($membership)) {
      // Reaching here at all is the exception. The cancellation forms take the
      // deleting options away while a record is being kept, and steer to
      // disabling the account instead, which keeps the address and contact
      // details the record was made with. This is the backstop for the routes
      // that do not go through a form: user_delete() called from a script or
      // another module, and an administrator who holds the permission to
      // override retention. The record still has to say whose it was — an
      // insurance record naming nobody is not a record.
      $membership->member_name = format_username($account);
      db_update('membership_entity')
        ->fields(array('member_name' => $membership->member_name))
        ->condition('mid', $membership->mid)
        ->execute();

      watchdog('membership_entity', 'Kept membership %member_id for %name after deleting their account: it is within its retention period.', array(
        '%member_id' => $membership->member_id,
        '%name' => $membership->member_name,
      ), WATCHDOG_NOTICE);
      continue;
    }

    membership_entity_delete($membership->mid);
  }

  // Delete secondary member records.
  db_delete('membership_entity_secondary_member')
    ->condition('uid', $account->uid)
    ->execute();
}

/**
 * Implements hook_element_info().
 */
function membership_entity_element_info() {
  return array(
    'membership_entity_member_select' => array(
      '#input' => TRUE,
      '#title' => '',
      '#description' => '',
      '#default_value' => array(),
      '#disabled' => FALSE,
      '#cardinality' => 1,
      '#required' => FALSE,
      '#autocomplete_path' => 'user/autocomplete',
      '#process' => array('membership_entity_member_select_process'),
      '#element_validate' => array('membership_entity_member_select_validate'),
    ),
  );
}

/**
 * Default value callback for membership_entity_member_select.
 */
function form_type_membership_entity_member_select_value($element, $input, &$form_state) {
  if ($input === FALSE && !empty($element['#default_value'])) {
    foreach ($element['#default_value'] as $delta => $uid) {
      // Expand the raw uid into username.
      $value[$delta] = array(
        'value' => db_query_range('SELECT name FROM {users} WHERE uid = :uid', 0, 1, array(':uid' => $uid))->fetchField(),
        '_weight' => $delta,
      );
    }
    return $value;
  }
  return $input;
}

/**
 * Process callback for the member select element.
 */
function membership_entity_member_select_process($element, &$form_state, $complete_form) {

  $multiple = ($element['#cardinality'] > 1 || $element['#cardinality'] == FIELD_CARDINALITY_UNLIMITED);
  $wrapper_id = backdrop_html_id($element['#id'] . '-add-more-wrapper');

  if ((is_array($element['#value']) || $element['#value'] instanceof Countable) && empty($form_state['items_count'][$element['#name']])) {
    // The 'Countable' interface is available in PHP 5.1+
    $form_state['items_count'][$element['#name']] = count($element['#value']);
  }

  if ($element['#cardinality'] == FIELD_CARDINALITY_UNLIMITED) {
    // The count is only recorded above when the value is an array, so an
    // element that has never held one leaves it unset. Reading it unguarded
    // warned twice on every render of an unlimited member select — "Undefined
    // array key" and then "Trying to access array offset on value of type
    // null" — and left $max as NULL.
    $max = isset($form_state['items_count'][$element['#name']])
      ? $form_state['items_count'][$element['#name']]
      : 0;
  }
  else {
    $max = $element['#cardinality'] - 1;
  }

  if ($multiple) {
    $field_element = array(
      '#theme' => 'field_multiple_value_form',
      '#field_name' => $element['#name'],
      '#prefix' => '<div id="' . $wrapper_id . '">',
      '#suffix' => '</div>',
      '#max_delta' => $max,
      '#tree' => TRUE,
    );
  }
  else {
    // Single value is displayed in a fieldset. A caller that has already
    // labelled the field — or that is offering it as one branch of a choice,
    // where the inner "Select an existing account" says everything needed —
    // passes an empty title, and gets no empty <label> element for it.
    $field_element = array('#tree' => TRUE);

    if ($element['#title'] !== '') {
      $field_element['#prefix'] = '<label>' . $element['#title'] . '</label>';
    }
  }

  $field_element += $element;
  for ($delta = 0; $delta <= $max; $delta++) {
    $id = backdrop_html_id($element['#id'] . '_' . $delta);
    $item['value'] = array(
      '#delta' => $delta,
      '#weight' => $delta,
      '#type' => 'textfield',
      '#title' => t('Select an existing account'),
      '#disabled' => $element['#disabled'],
      '#description' => filter_xss($element['#description']),
      '#autocomplete_path' => $element['#autocomplete_path'],
      '#default_value' => isset($element['#default_value'][$delta]) ? $element['#default_value'][$delta] : '',
      '#value_callback' => 'membership_entity_uid_value',
      // Only the first item should be required.
      '#required' => $delta == 0 && $element['#required'],
      '#id' => $id,
    );

    if ($element['#cardinality'] > 1 || $element['#cardinality'] == FIELD_CARDINALITY_UNLIMITED) {
      // We name the element '_weight' to avoid clashing with elements
      // defined by widget.
      $item['_weight'] = array(
        '#type' => 'weight',
        '#title' => t('Weight for row @number', array('@number' => $delta + 1)),
        '#title_display' => 'invisible',
        '#delta' => $max,
        '#default_value' => $delta,
        '#weight' => 100,
      );
    }

    $field_element[$delta] = $item;
  }

  // Add the "add more" button.
  if ($element['#cardinality'] == FIELD_CARDINALITY_UNLIMITED && empty($form_state['programmed'])) {
    $field_element['add_more'] = array(
      '#type' => 'submit',
      '#name' => strtr($element['#id'], '-', '_') . '_add_more',
      '#value' => t('Add another'),
      '#field_name' => $element['#name'],
      '#attributes' => array('class' => array('field-add-more-submit')),
      '#limit_validation_errors' => array(),
      '#submit' => array('membership_entity_member_select_add_more_submit'),
      '#ajax' => array(
        'callback' => 'membership_entity_member_select_add_more_js',
        'wrapper' => $wrapper_id,
        'effect' => 'fade',
      ),
    );
  }

  return $field_element;
}

/**
 * Submit handler for the "Add another" button of a member field.
 */
function membership_entity_member_select_add_more_submit($form, &$form_state) {
  $button = $form_state['triggering_element'];
  $form_state['items_count'][$button['#field_name']]++;
  $form_state['rebuild'] = TRUE;
}

/**
 * Ajax callback to add another member select widget.
 *
 * @see membership_entity_member_select_add_more_submit()
 */
function membership_entity_member_select_add_more_js($form, $form_state) {
  $button = $form_state['triggering_element'];

  // Go one level up in the form, to the widgets container.
  $element = backdrop_array_get_nested_value($form, array_slice($button['#array_parents'], 0, -1));

  if ($element['#cardinality'] != FIELD_CARDINALITY_UNLIMITED) {
    return;
  }

  // Add a DIV around the delta receiving the Ajax effect.
  $delta = $element['#max_delta'];
  $element[$delta]['#prefix'] = '<div class="ajax-new-content">' . (isset($element[$delta]['#prefix']) ? $element[$delta]['#prefix'] : '');
  $element[$delta]['#suffix'] = (isset($element[$delta]['#suffix']) ? $element[$delta]['#suffix'] : '') . '</div>';

  return $element;
}

/**
 * Element validate callback for the membership_entity_member_select element.
 */
function membership_entity_member_select_validate($element, &$form_state) {
  $values = array();
  if (!empty($element['#value'])) {
    foreach ($element['#value'] as $delta => $value) {
      if (!is_numeric($delta)) {
        continue;
      }

      if (!empty($value['value'])) {
        $name = $value['value'];
        if ($uid = db_query('SELECT uid FROM {users} WHERE name = :name', array(':name' => $name))->fetchField()) {
          // Save the value as a uid instead of username.
          $values[$delta] = $uid;
        }
        else {
          form_error($element[$delta], t('Could not find an account with the username %name', array('%name' => $name)));
        }
      }
    }
  }

  form_set_value($element, $values, $form_state);
  return $element;
}

/**
 * Value callback to display the username of a given user.
 */
function membership_entity_uid_value($element, $input = FALSE, $form_state = array()) {
  if ($input === FALSE && !empty($element['#default_value'])) {
    // Expand the raw uid into username.
    $uid = $element['#default_value'];
    return db_query('SELECT name FROM {users} WHERE uid = :uid LIMIT 1', array(':uid' => $uid))->fetchField();
  }
}

/**
 * Implements hook_action_info().
 */
function membership_entity_action_info() {
  $info['membership_entity_cancel_action'] = array(
    'type' => 'membership_entity',
    'label' => t('Cancel membership'),
    'configurable' => FALSE,
    'behavior' => array('changes_property'),
  );

  if (module_exists('path')) {
    $info['membership_entity_path_update_action'] = array(
      'type' => 'membership_entity',
      'label' => t('Update membership alias'),
      'configurable' => FALSE,
    );
  }
  return $info;
}

/**
 * Actions callback.
 *
 * Cancel a membership.
 */
function membership_entity_cancel_action($membership, $context = array()) {
  $membership->status = MEMBERSHIP_ENTITY_CANCELLED;
}

/**
 * Actions callback.
 *
 * Bulk update membership path aliases.
 */
function membership_entity_path_update_action($membership, $context = array()) {
  membership_entity_update_alias($membership, 'bulkupdate', array('message' => TRUE));
}

/**
 * Implements hook_views_api().
 */
function membership_entity_views_api() {
  return array(
    'api' => 3,
    'path' => backdrop_get_path('module', 'membership_entity') . '/views',
  );
}

/**
 * Convert a stdClass object to an instance of MembershipEntity.
 *
 * Shallow copies all properties of $object to a new
 * MembershipEntity instance.
 *
 * @param object $object
 *   The stdClass object to convert.
 *
 * @return MembershipEntity
 *   A new instance of MembershipEntity with all properties copied from $object.
 */
function membership_entity_create_from_stdclass($object) {
  $membership = membership_entity_create();
  foreach (get_object_vars($object) as $key => $value) {
    $membership->{$key} = $value;
  }
  return $membership;
}

/**
 * Create a new membership entity with default values.
 *
 * @param optioonal|array $values
 *   An associate array of default values for the membership.
 *
 * @return MembershipEntity
 *   The new (unsaved) membership object with default values.
 */
function membership_entity_create($values = array()) {
  return entity_create('membership_entity', $values);
}

/**
 * Load a single membership object.
 */
function membership_entity_load($mid = NULL, $reset = FALSE) {
  $memberships = membership_entity_load_multiple(array($mid), array(), $reset);
  return is_array($memberships) ? reset($memberships) : FALSE;
}

/**
 * Load a single membership object by member id.
 */
function membership_entity_load_by_member_id($member_id, $reset = FALSE) {
  $controller = entity_get_controller('membership_entity');
  if ($reset) {
    $controller->resetCache();
  }
  return $controller->loadByMemberID($member_id);
}

/**
 * Load all memberships for a given user.
 */
function membership_entity_load_by_user($account, $type = NULL, $reset = FALSE) {
  $controller = entity_get_controller('membership_entity');
  if ($reset) {
    $controller->resetCache();
  }
  return $controller->loadByUser($account, $type);
}

/**
 * Loads multiple membership objects.
 */
function membership_entity_load_multiple($mids = FALSE, $conditions = array(), $reset = FALSE) {
  return entity_load('membership_entity', $mids, $conditions, $reset);
}

/**
 * Implements hook_membership_entity_presave().
 */
function membership_entity_membership_entity_presave($membership) {
  // Generate a new member id for new memberships.
  if (!empty($membership->is_new) && empty($membership->member_id)) {
    $membership->member_id = membership_entity_next_member_id($membership);
  }
}

/**
 * Save a membership entity.
 *
 * @param MembershipEntity $membership
 *   MembershipEntity to save.
 */
function membership_entity_save(MembershipEntity $membership) {
  return $membership->save();
}

/**
 * Delete a membership entity.
 *
 * @param int $mid
 *   MembershipEntity ID to delete.
 */
function membership_entity_delete($mid) {
  membership_entity_delete_multiple(array($mid));
}

/**
 * Delete multiple membership entities.
 *
 * @param array $mids
 *   Array of MembershipEntity IDs to delete.
 */
function membership_entity_delete_multiple(array $mids) {
  entity_delete_multiple('membership_entity', $mids);
}

/**
 * Determine the status that actually governs a membership's access.
 *
 * A child membership only grants access while its parent is also active, so
 * that revoking an organisation's membership revokes everyone beneath it. The
 * child's own stored status is never rewritten by this: leaving it intact is
 * what allows an organisation to be reinstated and restore exactly the members
 * who were active before it lapsed.
 *
 * Where the parent is what blocks, the parent's status is returned rather than
 * a flat expiry, so the reason remains visible to the member and to the admin.
 *
 * Memberships are limited to two levels, so the parent can never itself have a
 * parent and no recursion is required here.
 *
 * @param MembershipEntity $membership
 *   The membership to resolve.
 *
 * @return int
 *   One of the MEMBERSHIP_ENTITY_* status constants.
 */
function membership_entity_effective_status(MembershipEntity $membership) {
  $status = (int) $membership->status;

  // Only an otherwise active membership can be blocked by its parent. A
  // membership that has already expired on its own terms stays that way.
  if (!empty($membership->pid) && $status == MEMBERSHIP_ENTITY_ACTIVE) {
    $parent_status = db_query('SELECT status FROM {membership_entity} WHERE mid = :mid', array(
      ':mid' => $membership->pid,
    ))->fetchField();

    // A missing parent leaves the membership governed by its own status.
    if ($parent_status !== FALSE && (int) $parent_status != MEMBERSHIP_ENTITY_ACTIVE) {
      $status = (int) $parent_status;
    }
  }

  backdrop_alter('membership_entity_effective_status', $status, $membership);
  return $status;
}

/**
 * Whether the current user may create the primary member's account from the
 * membership form.
 *
 * Offered only while adding a membership, never while editing one: changing who
 * a membership belongs to is a different act from naming who it is for, and
 * conflating them would let an edit silently mint accounts.
 *
 * Other modules may widen this through
 * hook_membership_entity_may_create_member_account_alter() - which is how
 * membership_entity_hierarchy lets an association secretary add a member who
 * has no account yet. What can be created is bounded: an ordinary
 * authenticated account with a random password and no roles of its own. Roles
 * arrive only through membership status, by way of the controller.
 *
 * @param MembershipEntity $membership
 *   The membership being added.
 *
 * @return bool
 *   TRUE if the account creation fields should be offered.
 */
function membership_entity_may_create_member_account(MembershipEntity $membership) {
  if (!empty($membership->mid)) {
    return FALSE;
  }

  $may = user_access('administer memberships') || user_access('administer users');
  backdrop_alter('membership_entity_may_create_member_account', $may, $membership);
  return (bool) $may;
}

/**
 * How long something has lasted, counted on the calendar.
 *
 * Deliberately not format_interval(), which works from flat 365 day years and
 * 30 day months and so drifts — a span of exactly ten years comes back from it
 * as nine (backdrop core issue 7069). DateTime::diff() counts real months and
 * real years, including the leap days, which is what somebody reading "member
 * for 21 years" expects it to mean.
 *
 * @param int $from
 *   A timestamp to count from.
 * @param int $to
 *   A timestamp to count to. Defaults to now.
 *
 * @return string
 *   A translated span, to at most two units.
 */
function membership_entity_format_duration($from, $to = NULL) {
  $to = isset($to) ? $to : REQUEST_TIME;

  $diff = date_diff(
    date_create('@' . $from)->setTimezone(new DateTimeZone(backdrop_get_user_timezone())),
    date_create('@' . $to)->setTimezone(new DateTimeZone(backdrop_get_user_timezone()))
  );

  $parts = array();
  if ($diff->y) {
    $parts[] = format_plural($diff->y, '1 year', '@count years');
  }
  if ($diff->m && count($parts) < 2) {
    $parts[] = format_plural($diff->m, '1 month', '@count months');
  }
  if (empty($parts)) {
    $parts[] = format_plural($diff->d, '1 day', '@count days');
  }

  return implode(' ', $parts);
}

/**
 * The name of a membership's primary member.
 *
 * A membership kept past the deletion of its user account has no account to ask,
 * so the name recorded at that moment is used instead. Callers should use this
 * rather than format_username(user_load($membership->uid)), which returns
 * nothing at all for a membership whose member has gone.
 *
 * @param MembershipEntity $membership
 *   The membership to name.
 *
 * @return string
 *   A plain, unsanitised name.
 */
function membership_entity_member_name(MembershipEntity $membership) {
  if (!empty($membership->uid) && ($account = user_load($membership->uid))) {
    return format_username($account);
  }

  if (!empty($membership->member_name)) {
    return $membership->member_name;
  }

  return t('(member removed)');
}

/**
 * A current membership of this type already held by this person, if any.
 *
 * One membership per person per type was assumed by the original module rather
 * than decided, and it rules out three things that are now supported: rejoining
 * while the lapsed record is still being kept, belonging to two associations at
 * once, and deliberately being a member of more than one branch. The membership
 * type says which it wants.
 *
 * Only a membership that is still current counts. A lapsed one is either
 * reinstated on renewal or left alone as history; either way it is not a reason
 * to refuse a new one.
 *
 * @param int $uid
 *   The user who would hold the membership.
 * @param string $type
 *   The membership type.
 * @param int $exclude_mid
 *   A membership id to ignore, being the one under edit.
 *
 * @return int|false
 *   The membership id standing in the way, or FALSE if nothing does.
 */
function membership_entity_conflicting_membership($uid, $type, $exclude_mid = 0) {
  if (empty($uid) || membership_entity_allows_multiple_memberships($type)) {
    return FALSE;
  }

  $mid = db_query_range('SELECT mid FROM {membership_entity} WHERE uid = :uid AND type = :type AND status = :status AND mid <> :mid', 0, 1, array(
    ':uid' => $uid,
    ':type' => $type,
    ':status' => MEMBERSHIP_ENTITY_ACTIVE,
    ':mid' => (int) $exclude_mid,
  ))->fetchField();

  return $mid ? (int) $mid : FALSE;
}

/**
 * Whether a membership can be renewed right now.
 *
 * Wraps the term module's access check so callers do not have to know whether
 * that module is enabled. Without it there is no renewing at all, and a
 * rejoining member has to be given a new membership whatever the type says.
 *
 * @param MembershipEntity $membership
 *   The membership to test.
 *
 * @return bool
 *   TRUE if the renew form would accept it.
 */
function membership_entity_term_access_renew(MembershipEntity $membership) {
  if (!module_exists('membership_entity_term')) {
    return FALSE;
  }

  return (bool) membership_entity_term_access('renew', $membership);
}

/**
 * The membership a rejoining member should be given back, if any.
 *
 * Where the type reinstates rather than reissuing, somebody coming back after a
 * lapse carries on with the membership they had — same record, same member
 * number, same history, with the gap left visible in the term ledger. The
 * alternative is a second membership and a second number, which is what this
 * module did unconditionally until now.
 *
 * Only a membership that has lapsed is offered back. An active one is not a
 * rejoin, it is a renewal, and the two are different acts.
 *
 * @param object $account
 *   The user coming back.
 * @param string $type
 *   The membership type being joined.
 *
 * @return MembershipEntity|false
 *   The membership to reinstate, or FALSE to create a new one.
 */
function membership_entity_membership_to_reinstate($account, $type) {
  $settings = membership_entity_get_bundle_settings($type);
  if (empty($settings['rejoin_policy']) || $settings['rejoin_policy'] != 'reinstate') {
    return FALSE;
  }

  $uid = is_object($account) ? $account->uid : $account;
  if (empty($uid)) {
    return FALSE;
  }

  $candidates = array();
  foreach (membership_entity_load_by_user($uid, NULL, TRUE) as $membership) {
    if ($membership->type == $type && (int) $membership->status !== MEMBERSHIP_ENTITY_ACTIVE) {
      $candidates[$membership->mid] = $membership;
    }
  }

  if (empty($candidates)) {
    return FALSE;
  }

  // The most recent, by mid. Somebody who has been round this loop more than
  // once should come back to where they left off, not to their first ever
  // membership — the same reasoning as the generic renew page.
  return $candidates[max(array_keys($candidates))];
}

/**
 * Whether a person may hold more than one membership of a type at once.
 *
 * @param string $type
 *   The membership type.
 *
 * @return bool
 *   TRUE if a second concurrent membership is allowed.
 */
function membership_entity_allows_multiple_memberships($type) {
  $settings = membership_entity_get_bundle_settings($type);
  return !empty($settings['multiple_memberships']);
}

/**
 * The retention periods a membership type may be given.
 *
 * @return array
 *   Period strings, understood by strtotime(), keyed for a select list.
 */
function membership_entity_retention_periods() {
  return array(
    '' => t('Remove as soon as an administrator chooses'),
    '6 months' => t('6 months after it lapses'),
    '1 year' => t('1 year after it lapses'),
    '2 years' => t('2 years after it lapses'),
    '3 years' => t('3 years after it lapses'),
    '6 years' => t('6 years after it lapses'),
    '7 years' => t('7 years after it lapses'),
    '10 years' => t('10 years after it lapses'),
    'forever' => t('Keep indefinitely'),
  );
}

/**
 * When a membership stopped being current.
 *
 * The end of its last term is the honest answer where there is one, because
 * that is the date cover actually stopped rather than the date somebody got
 * round to recording it. A membership that never had a term falls back to when
 * it was last changed.
 *
 * @param MembershipEntity $membership
 *   The membership to date.
 *
 * @return int|null
 *   A timestamp, or NULL if the membership is still active.
 */
function membership_entity_lapsed_date(MembershipEntity $membership) {
  if ((int) $membership->status === MEMBERSHIP_ENTITY_ACTIVE) {
    return NULL;
  }

  $end = db_query('SELECT MAX(end) FROM {membership_entity_term} WHERE mid = :mid', array(
    ':mid' => $membership->mid,
  ))->fetchField();

  if (!empty($end)) {
    return strtotime($end);
  }

  return !empty($membership->changed) ? (int) $membership->changed : NULL;
}

/**
 * The date a lapsed membership may be removed.
 *
 * @param MembershipEntity $membership
 *   The membership to test.
 *
 * @return int|false|null
 *   A timestamp, FALSE where the record is to be kept indefinitely, or NULL
 *   where nothing stands in the way of removing it now.
 */
function membership_entity_retention_expires(MembershipEntity $membership) {
  $settings = membership_entity_get_bundle_settings($membership->type);
  $period = isset($settings['retention_period']) ? $settings['retention_period'] : '';

  if ($period === '') {
    return NULL;
  }
  if ($period === 'forever') {
    return FALSE;
  }

  // An active membership is not lapsed, so the clock has not started. It is
  // still protected: there is no date on which it becomes removable.
  $lapsed = membership_entity_lapsed_date($membership);
  if (empty($lapsed)) {
    return FALSE;
  }

  return strtotime('+' . $period, $lapsed);
}

/**
 * Whether a membership is still inside its retention period.
 *
 * @param MembershipEntity $membership
 *   The membership to test.
 *
 * @return bool
 *   TRUE if the record is to be kept for now.
 */
function membership_entity_is_retained(MembershipEntity $membership) {
  $expires = membership_entity_retention_expires($membership);

  if ($expires === NULL) {
    return FALSE;
  }
  if ($expires === FALSE) {
    return TRUE;
  }

  return $expires > REQUEST_TIME;
}

/**
 * Explain, in one sentence, why a membership is being kept.
 *
 * @param MembershipEntity $membership
 *   The membership being kept.
 *
 * @return string
 *   Translated text naming the date, or saying there is not one.
 */
function membership_entity_retention_reason(MembershipEntity $membership) {
  $expires = membership_entity_retention_expires($membership);

  if ($expires === FALSE) {
    if ((int) $membership->status === MEMBERSHIP_ENTITY_ACTIVE) {
      return t('Membership %member_id is active. Only a lapsed membership can be removed.', array(
        '%member_id' => $membership->member_id,
      ));
    }
    return t('Membership %member_id is kept indefinitely by the retention policy for this membership type.', array(
      '%member_id' => $membership->member_id,
    ));
  }

  return t('Membership %member_id is kept until @date by the retention policy for this membership type.', array(
    '%member_id' => $membership->member_id,
    '@date' => format_date($expires, 'custom', 'j F Y'),
  ));
}

/**
 * Return the membership ids of a membership's children.
 *
 * @param int $mid
 *   The membership id of the parent.
 *
 * @return array
 *   An array of child membership ids, empty if there are none.
 */
function membership_entity_child_mids($mid) {
  if (empty($mid)) {
    return array();
  }

  return db_query('SELECT mid FROM {membership_entity} WHERE pid = :pid', array(
    ':pid' => $mid,
  ))->fetchCol();
}

/**
 * Count a membership's children.
 *
 * Used to enforce the membership type's max_children limit and to block the
 * deletion of a membership that still has members beneath it.
 *
 * @param int $mid
 *   The membership id of the parent.
 *
 * @return int
 *   The number of child memberships.
 */
function membership_entity_child_count($mid) {
  if (empty($mid)) {
    return 0;
  }

  return (int) db_query('SELECT COUNT(mid) FROM {membership_entity} WHERE pid = :pid', array(
    ':pid' => $mid,
  ))->fetchField();
}

/**
 * Property getter for a membership's parent.
 *
 * A membership with no parent stores pid 0, not NULL. Handing that to a
 * metadata wrapper typed as an entity reference leaves it holding an id that
 * cannot be loaded, and tokens then render the wrapper itself rather than
 * clearing. Returning NULL instead makes an absent parent read as an empty
 * property everywhere.
 *
 * @param MembershipEntity $membership
 *   The membership being read.
 *
 * @return int|null
 *   The parent's membership id, or NULL if it has no parent.
 *
 * @see MembershipEntityMetadataController::entityPropertyInfo()
 */
function membership_entity_metadata_get_parent($membership) {
  return empty($membership->pid) ? NULL : (int) $membership->pid;
}

/**
 * A human readable label for a membership acting as a parent.
 *
 * Matches the labels used by the parent selector: the primary member's name is
 * what is being recognised, with the member id kept for the case of two
 * members sharing a name. A membership labels itself by member id alone, which
 * identifies nothing to the person reading it.
 *
 * @param int $mid
 *   The membership id.
 *
 * @return string
 *   A plain, unsanitized label, or an empty string if the membership is gone.
 *   Callers must escape it. Deliberately not built with t()'s @ placeholders,
 *   which would sanitize here and leave every caller double escaping.
 */
function membership_entity_parent_label($mid) {
  if (empty($mid)) {
    return '';
  }

  $query = db_select('membership_entity', 'me')
    ->fields('me', array('member_id'))
    ->condition('me.mid', $mid);
  $query->leftJoin('users', 'u', 'u.uid = me.uid');
  $query->addField('u', 'name', 'username');
  $row = $query->execute()->fetchObject();

  if (empty($row)) {
    return '';
  }

  return !empty($row->username)
    ? format_string('!name (!id)', array('!name' => $row->username, '!id' => $row->member_id))
    : $row->member_id;
}

/**
 * Implements hook_mail_alter().
 *
 * A member flagged "do not contact" is sent nothing, renewal notices included.
 */
function membership_entity_mail_alter(&$message) {
  if (empty($message['to'])) {
    return;
  }

  if (membership_entity_is_no_contact_address($message['to'])) {
    $message['send'] = FALSE;
  }
}

/**
 * Pull a bare address out of a mail header.
 *
 * A header may carry the display form, "Someone <someone@example.com>". Missing
 * that would let every suppressed message through with no sign anything was
 * wrong, which is the worst way for a suppression to fail.
 *
 * @param string $mail
 *   An address, in either form.
 *
 * @return string
 *   The bare address.
 */
function membership_entity_mail_address($mail) {
  if (preg_match('/<([^>]+)>\s*$/', $mail, $matches)) {
    return trim($matches[1]);
  }

  return trim($mail);
}

/**
 * Whether an address belongs to somebody who must not be contacted.
 *
 * The flag lives on the membership, because that is the record an administrator
 * is looking at when they learn of a death or a request to be left alone. It
 * suppresses mail to the account the membership belongs to, whichever of their
 * memberships was flagged — somebody who must not be written to must not be
 * written to about anything.
 *
 * @param string $mail
 *   An address, bare or in header form.
 *
 * @return bool
 *   TRUE if nothing should be sent there.
 */
function membership_entity_is_no_contact_address($mail) {
  if (empty($mail)) {
    return FALSE;
  }

  $addresses = &backdrop_static(__FUNCTION__, array());
  $address = backdrop_strtolower(membership_entity_mail_address($mail));

  if (!isset($addresses[$address])) {
    $addresses[$address] = (bool) db_query_range('SELECT 1 FROM {membership_entity} m INNER JOIN {users} u ON u.uid = m.uid WHERE m.no_contact = 1 AND LOWER(u.mail) = :mail', 0, 1, array(
      ':mail' => $address,
    ))->fetchField();
  }

  return $addresses[$address];
}

/**
 * Private: Reapply roles to every child of a membership.
 *
 * Called when a parent's status has changed. The children's own stored statuses
 * are untouched — only the roles derived from them move — so this deliberately
 * does not save the child memberships. That also keeps the controller from
 * re-entering itself.
 *
 * @param MembershipEntity $parent
 *   The parent membership whose status has just changed.
 */
function _membership_entity_propagate_to_children(MembershipEntity $parent) {
  $child_mids = membership_entity_child_mids($parent->mid);
  if (empty($child_mids)) {
    return;
  }

  $roles = array();
  foreach (membership_entity_load_multiple($child_mids) as $child) {
    $data = membership_entity_get_bundle_settings($child->type);
    $op = (membership_entity_effective_status($child) == MEMBERSHIP_ENTITY_ACTIVE) ? 'add' : 'remove';

    $roles[$child->uid] = array(
      'rid' => $data['primary_role'],
      'op' => $op,
    );
    foreach ($child->secondary_members as $uid) {
      $roles[$uid] = array(
        'rid' => $data['secondary_role'],
        'op' => $op,
      );
    }
  }

  _membership_entity_update_roles($roles);
}

/**
 * Private: Add/Remove roles managed by the membership.
 *
 * Backdrop stores $account->roles as an unindexed array of role machine names,
 * unlike Drupal 7 where it was keyed by role ID. Membership roles must
 * therefore be matched by value; keying by role name causes the same role to be
 * appended on every save (a duplicate key error on {users_roles}) and makes
 * revocation on expiry silently do nothing.
 *
 * Accounts that are currently being deleted are skipped; see
 * membership_entity_user_delete().
 *
 * A role is only removed when no other active membership of the user still
 * grants it. One person can hold two memberships - an old one that lapsed and
 * the one they rejoined with - and the old one lapsing, being saved or being
 * deleted must not take away what the new one gives.
 *
 * @param array $roles
 *   Array of role operations keyed by user ID. Each value is an array with a
 *   'rid' role machine name and an 'op' of either 'add' or 'remove'.
 * @param array $exclude_mids
 *   Memberships whose stored record is about to change, and so must not count
 *   as still granting a role: the one being saved or the ones being deleted.
 */
function _membership_entity_update_roles(array $roles, array $exclude_mids = array()) {
  $accounts = user_load_multiple(array_keys($roles));
  $deleting = &backdrop_static('membership_entity_deleting_users', array());

  foreach ($accounts as $uid => $account) {
    $rid = $roles[$uid]['rid'];

    // A membership type with no role configured has nothing to do.
    if (empty($rid)) {
      continue;
    }

    // Never save an account that is being deleted — see
    // membership_entity_user_delete().
    if (isset($deleting[$uid])) {
      continue;
    }

    $has_role = in_array($rid, $account->roles, TRUE);
    if ($roles[$uid]['op'] == 'add' && !$has_role) {
      $account->roles[] = $rid;
      user_save($account);
    }
    elseif ($roles[$uid]['op'] == 'remove' && $has_role && !_membership_entity_role_held_elsewhere($uid, $rid, $exclude_mids)) {
      $account->roles = array_values(array_diff($account->roles, array($rid)));
      user_save($account);
    }
  }
}

/**
 * Private: Whether another active membership still grants a user a role.
 *
 * Counts memberships the user holds as primary member and those they are a
 * secondary member of, by effective status, so a sub-membership under a lapsed
 * parent grants nothing.
 *
 * @param int $uid
 *   The user losing the role.
 * @param string $rid
 *   The role machine name.
 * @param array $exclude_mids
 *   Memberships to leave out of the count.
 *
 * @return bool
 *   TRUE if some other active membership grants the role.
 */
function _membership_entity_role_held_elsewhere($uid, $rid, array $exclude_mids = array()) {
  $query = db_select('membership_entity', 'm')
    ->fields('m', array('mid'))
    ->condition('m.uid', $uid)
    ->condition('m.status', MEMBERSHIP_ENTITY_ACTIVE);
  if ($exclude_mids) {
    $query->condition('m.mid', $exclude_mids, 'NOT IN');
  }
  $primary = $query->execute()->fetchCol();

  $query = db_select('membership_entity_secondary_member', 's');
  $query->innerJoin('membership_entity', 'm', 'm.mid = s.mid');
  $query->fields('m', array('mid'))
    ->condition('s.uid', $uid)
    ->condition('m.status', MEMBERSHIP_ENTITY_ACTIVE);
  if ($exclude_mids) {
    $query->condition('m.mid', $exclude_mids, 'NOT IN');
  }
  $secondary = $query->execute()->fetchCol();

  if (!$primary && !$secondary) {
    return FALSE;
  }

  foreach (membership_entity_load_multiple(array_merge($primary, $secondary)) as $mid => $membership) {
    $data = membership_entity_get_bundle_settings($membership->type);
    $grants = in_array($mid, $primary) ? $data['primary_role'] : $data['secondary_role'];
    if ($grants == $rid && membership_entity_effective_status($membership) == MEMBERSHIP_ENTITY_ACTIVE) {
      return TRUE;
    }
  }
  return FALSE;
}
